<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/watch_settings_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/watch_settings_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/settings_header_logo"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:src="@drawable/ic_vector_logo_no_icon"
            android:padding="@dimen/vertical_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ToolbarTheme"
            app:layout_collapseMode="pin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_kid_profile_form"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Watch Info Header -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/user_name_textview"
                style="@style/SettingsTitleTextPurple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/poppins_extrabold"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Orlix Rico" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/watch_model_textview"
                style="@style/SettingsDescriptionTextPurple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Space Lite 1.0" />

            <!-- Watch Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/watch_card"
                android:layout_marginTop="@dimen/vertical_margin_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/watch_settings_background"
                app:cardCornerRadius="24dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/watch_id_textview"
                        style="@style/SettingsTitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:layout_marginVertical="@dimen/vertical_margin"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="ID: 374859382748" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/phone_number_textview"
                        style="@style/SettingsDescriptionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="+56912345678"
                        app:layout_constraintStart_toStartOf="@id/watch_id_textview"
                        app:layout_constraintTop_toBottomOf="@id/watch_id_textview" />

                    <include
                        android:id="@+id/button_find"
                        layout="@layout/settings_cardview_menu_watchinfo_watchbutton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        android:layout_marginVertical="@dimen/vertical_margin"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/phone_number_textview"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.15" />

                    <include
                        android:id="@+id/button_turn_off"
                        layout="@layout/settings_cardview_menu_watchinfo_powerbutton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        app:layout_constraintBottom_toBottomOf="@id/button_find"
                        app:layout_constraintStart_toEndOf="@id/button_find"
                        app:layout_constraintTop_toTopOf="@id/button_find"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.15" />

                    <include
                        android:id="@+id/button_share"
                        layout="@layout/settings_cardview_menu_watchinfo_sharebutton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        app:layout_constraintBottom_toBottomOf="@id/button_find"
                        app:layout_constraintStart_toEndOf="@id/button_turn_off"
                        app:layout_constraintTop_toTopOf="@id/button_find"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.15" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.65" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/watch_profile_picture"
                        style="@style/contactImageView"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_small"
                        android:layout_marginVertical="@dimen/vertical_margin_small"
                        android:src="@drawable/momo_picture_default"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/guideline"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/watch_profile_picture_edit_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/sim_button_positive"
                        android:foregroundTint="@color/white"
                        android:src="@drawable/watch_settings_edit"
                        android:layout_marginBottom="-8dp"
                        app:fabCustomSize="36dp"
                        android:contentDescription="@null"
                        app:layout_constraintBottom_toBottomOf="@id/watch_profile_picture"
                        app:layout_constraintEnd_toEndOf="@id/watch_profile_picture"
                        app:tint="@color/white" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 1: Location & Safety -->
            <LinearLayout
                android:id="@+id/section_location_safety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/header_location_safety"
                    layout="@layout/item_watch_setting_section" />

                <include
                    android:id="@+id/item_location_history"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_lock_hours"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_gps_settings"
                    layout="@layout/item_watch_setting" />

            </LinearLayout>

            <!-- Section 2: Communication -->
            <LinearLayout
                android:id="@+id/section_communication"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/header_communication"
                    layout="@layout/item_watch_setting_section" />

                <include
                    android:id="@+id/item_contacts"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_my_friends"
                    layout="@layout/item_watch_setting" />

            </LinearLayout>

            <!-- Section 3: Tools & Activity -->
            <LinearLayout
                android:id="@+id/section_tools_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/header_tools_activity"
                    layout="@layout/item_watch_setting_section" />

                <include
                    android:id="@+id/item_alarms"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_calendar"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_reminders"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_steps"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_heymomo_history"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_lingo_progress"
                    layout="@layout/item_watch_setting" />

            </LinearLayout>

            <!-- Section 4: Device Settings -->
            <LinearLayout
                android:id="@+id/section_device_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/header_device_settings"
                    layout="@layout/item_watch_setting_section" />

                <include
                    android:id="@+id/item_installed_apps"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_sound"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_battery_saving"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_dialpad"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_time_timezone"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_language"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_rewards"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_watch_info"
                    layout="@layout/item_watch_setting" />

            </LinearLayout>

            <!-- Section 5: Administration -->
            <LinearLayout
                android:id="@+id/section_administration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/header_administration"
                    layout="@layout/item_watch_setting_section" />

                <include
                    android:id="@+id/item_pending_requests"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_new_owner"
                    layout="@layout/item_watch_setting" />

                <include
                    android:id="@+id/item_remove_watch"
                    layout="@layout/item_watch_setting" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
