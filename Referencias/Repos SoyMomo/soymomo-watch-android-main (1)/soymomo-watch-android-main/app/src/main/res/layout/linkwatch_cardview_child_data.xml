<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="viewModel"
            type="com.sosmartlabs.momo.linkwatch.ui.LinkWatchChildDataViewModel" />
    </data>
<com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/link_watch_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_kid_profile_form"
        android:padding="16dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/child_data_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/child_profile_title"
            style="@style/LinkWatchTitleTextPurple"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </com.google.android.material.textview.MaterialTextView>

        <ScrollView
            android:id="@+id/child_data_scrollview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/child_data_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ViewFlipper
                    android:id="@+id/child_data_viewflipper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin_small"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="@id/name_textinput"
                    app:layout_constraintEnd_toEndOf="@id/name_textinput">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="@color/link_step_background">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/error_message"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            tools:visibility="visible">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/icon_net"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:srcCompat="@drawable/ic_error">

                            </com.google.android.material.imageview.ShapeableImageView>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/net_error_description"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toEndOf="@id/icon_net"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:text="@string/indicate_data_error"
                                style="@style/LinkWatchDescriptionText"
                                android:textColor="@color/error_text_color"
                                android:textSize="@dimen/hint_text_size"
                                android:layout_marginHorizontal="@dimen/horizontal_margin">

                            </com.google.android.material.textview.MaterialTextView>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                </ViewFlipper>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/name_textinput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/name"
                    style="@style/Widget.App.TextInputLayout.PurpleColoredBox.NotCurved"
                    app:layout_constraintTop_toBottomOf="@id/child_data_viewflipper"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:layout_marginVertical="@dimen/vertical_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="textWebEditText"
                        android:text="@={viewModel.firstNameData}">

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/lastName_textinput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/last_name"
                    style="@style/Widget.App.TextInputLayout.PurpleColoredBox.NotCurved"
                    app:layout_constraintTop_toBottomOf="@id/name_textinput"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:layout_marginVertical="@dimen/vertical_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="textWebEditText"
                        android:text="@={viewModel.lastNameData}">

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/birthday_textinput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/birthday"
                    style="@style/Widget.App.TextInputLayout.PurpleColoredBox.NotCurved"
                    app:layout_constraintTop_toBottomOf="@id/lastName_textinput"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:layout_marginVertical="@dimen/vertical_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/date_picker"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="date"
                        android:focusable="false"
                        android:longClickable="false"
                        tools:ignore="TouchTargetSizeCheck" >

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/height_textinput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.42"
                    android:hint="@string/profile_height_cm"
                    style="@style/Widget.App.TextInputLayout.PurpleColoredBox.NotCurved"
                    app:layout_constraintTop_toBottomOf="@id/birthday_textinput"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:layout_marginVertical="@dimen/vertical_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="number"
                        android:text="@={viewModel.heightData}">

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/weight_textinput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.42"
                    android:hint="@string/profile_weight_kg"
                    style="@style/Widget.App.TextInputLayout.PurpleColoredBox.NotCurved"
                    app:layout_constraintTop_toBottomOf="@id/birthday_textinput"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:layout_marginVertical="@dimen/vertical_margin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="number"
                        android:text="@={viewModel.weightData}">

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/link_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:layout_marginVertical="@dimen/vertical_margin"
                    android:backgroundTint="@color/linkwatch_green_button"
                    android:fontFamily="@font/poppins"
                    android:text="@string/completed_string"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="32dp"
                    app:layout_constraintBottom_toTopOf="@id/admin_step_hint_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/height_textinput">

                </com.google.android.material.button.MaterialButton>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/admin_step_hint_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/child_step_hint_linkwatch"
                    style="@style/LinkWatchDescriptionTextPurple"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:textSize="@dimen/hint_text_size">

                </com.google.android.material.textview.MaterialTextView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
</layout>