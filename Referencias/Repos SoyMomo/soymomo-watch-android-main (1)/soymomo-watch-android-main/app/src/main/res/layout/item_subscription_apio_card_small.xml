<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/apio_card_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/vertical_margin_small"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        style="@style/SimContentCardView"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/apio_card_small_card_view"
                android:layout_width="80dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="@dimen/horizontal_margin"
                android:layout_marginVertical="@dimen/vertical_margin_small"
                tools:cardBackgroundColor="@color/bank_card_bg_visa"
                tools:background="@color/bank_card_bg_visa"
                app:cardCornerRadius="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="2:1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/apio_card_small_card_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" >

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/apio_card_small_card_logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/vertical_margin_small"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_small"
                        tools:srcCompat="@drawable/bank_card_visa"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/apio_card_small_digits"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:layout_marginHorizontal="@dimen/horizontal_margin_small"
                app:layout_constraintStart_toEndOf="@id/apio_card_small_card_view"
                app:layout_constraintEnd_toStartOf="@id/apio_card_small_arrow"
                app:layout_constraintTop_toTopOf="@id/apio_card_small_card_view"
                tools:text="XXXXXXXXXXXX6623" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/apio_card_small_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/apio_card_small_digits"
                app:layout_constraintEnd_toStartOf="@id/apio_card_small_arrow"
                app:layout_constraintTop_toBottomOf="@id/apio_card_small_digits"
                app:layout_constraintBottom_toBottomOf="@id/apio_card_small_card_view"
                tools:text="Francisco Ordenes" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/apio_card_small_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_arrow_go"
                android:layout_margin="@dimen/vertical_margin"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>