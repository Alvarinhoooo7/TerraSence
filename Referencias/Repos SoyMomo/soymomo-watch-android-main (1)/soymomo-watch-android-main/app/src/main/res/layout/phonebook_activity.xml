<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.sosmartlabs.momo.phonebook.PhoneBookActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_sim_step_card_title"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:theme="@style/ToolbarTheme" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/phone_contacts_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/appbar"
            app:layout_constraintBottom_toBottomOf="parent" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/no_contacts_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:constraint_referenced_ids="no_contacts_image,no_contacts_text" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/no_contacts_image"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_margin="40dp"
            android:background="@color/phonebook_no_contacts_image_background"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_person_add"
            app:shapeAppearanceOverlay="@style/circleImageView"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/appbar" />

        <TextView
            android:id="@+id/no_contacts_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="30dp"
            android:textSize="18sp"
            android:textAlignment="center"
            android:text="@string/no_contacts_text"
            app:layout_constraintTop_toBottomOf="@id/no_contacts_image" />

        <!-- Scrim to close menu -->
        <View
            android:id="@+id/fab_scrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/black"
            android:alpha="0"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Speed dial -->
        <LinearLayout
            android:id="@+id/speed_dial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:alpha="0"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/fab_main">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fab_add_from_contacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="0dp"
                android:translationZ="0dp"
                app:elevation="0dp"
                android:text="@string/contacts_add_from_contacts"
                app:icon="@drawable/ic_contacto_libreta"
                android:shadowColor="@color/transparent"
                android:textColor="@color/white"
                app:iconTint="@color/white"
                app:backgroundTint="@color/sim_button_positive" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fab_add_manual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="0dp"
                android:translationZ="0dp"
                app:elevation="0dp"
                android:layout_marginTop="8dp"
                android:text="@string/contacts_add_manual"
                app:icon="@drawable/ic_contacto_manual"
                android:shadowColor="@color/transparent"
                android:textColor="@color/white"
                app:iconTint="@color/white"
                app:backgroundTint="@color/sim_button_positive" />
        </LinearLayout>

        <!-- Main FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            app:srcCompat="@drawable/ic_add_24"
            app:tint="@color/white"
            app:backgroundTint="@color/sim_button_positive"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>