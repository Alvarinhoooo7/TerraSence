    <style name="mainBarButtonActive" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="pressedTranslationZ">0dp</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="fabCustomSize">0dp</item>
        <item name="maxImageSize">32dp</item>
        <item name="tint">@color/white</item>
        <item name="elevation">0dp</item>
        <item name="borderWidth">0dp</item>
    </style>

    <style name="roundTopCardView" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance_custom_corners</item>
    </style>

    <style name="ShapeAppearance_custom_corners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/round_card_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/round_card_corner_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="MainToolbarTheme" parent="AppTheme">
        <item name="android:textColorSecondary">@color/colorPrimary</item>
        <item name="android:textColorPrimary">@color/colorPrimary</item>
        <item name="android:actionMenuTextColor">@color/colorPrimary</item>
    </style>

    <style name="TextViewSubscriptionFormLabel">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">@dimen/vertical_margin</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WideButton" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="cornerRadius">@dimen/first_momo_button_border</item>
        <item name="android:elevation">@dimen/card_elevation</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="NegativeWideButton" parent="WideButton">
        <item name="backgroundTint">#FF6297</item>
    </style>

    <!-- SIM Styles -->
    <style name="SimDialogStepText">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="SimDialogStepTitle" parent="SimDialogStepText">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="SimDialogStepSubtitle" parent="SimDialogStepText">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SimStepCardHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="layout_constraintDimensionRatio">h,.6</item>
    </style>

    <style name="SimStepCardHeader.Over" parent="SimStepCardHeader">
        <item name="android:background">@drawable/sim_card_header_background</item>
    </style>

    <style name="SimStepCardHeader.Under" parent="SimStepCardHeader">
        <item name="android:background">@color/background_sim_step_card_title</item>
    </style>

    <style name="SimStepCardTitle" parent="SimDialogStepText">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="SimStepCardImage" >
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="layout_constraintHeight_percent">.8</item>
        <item name="layout_constraintVertical_bias">0</item>
    </style>

    <style name="SimStepCardContent" parent="SimDialogStepText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/background_sim_step_card_title</item>
        <item name="android:textAlignment">textStart</item>
    </style>

    <style name="SimButton" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="cornerRadius">@dimen/first_momo_button_border</item>
        <item name="android:elevation">@dimen/card_elevation</item>
        <item name="android:textColor">@color/sim_button_text_color</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="SimButton.Positive" parent="SimButton">
        <item name="backgroundTint">@color/sim_button_positive_selector</item>
    </style>

    <style name="SimButton.Negative" parent="SimButton">
        <item name="backgroundTint">@color/sim_button_negative_selector</item>
    </style>

    <style name="SimTextInputLayoutStyle" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/sim_text_input_layout_stroke_color</item>
        <item name="strokeWidth">2dp</item>
        <item name="boxStrokeErrorColor">@color/colorAccent</item>
        <item name="errorTextColor">@color/colorAccent</item>
        <item name="errorIconTint">@color/colorAccent</item>
        <item name="android:textColorHint">@color/sim_edit_text_hint_color</item>
        <item name="hintTextColor">@color/sim_edit_text_hint_color</item>
        <item name="suffixTextColor">@color/sim_text_input_box_color</item>
        <item name="shapeAppearance">@style/SimCardInputLayoutAppearance</item>
    </style>

    <style name="SimCardInputLayoutAppearance" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="SimContentCardView" parent="Widget.MaterialComponents.CardView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.SimContentCardView</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SimContentCardView</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="ThemeOverlay.App.SimContentCardView" parent="">
        <item name="colorPrimary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
    </style>

    <style name="ShapeAppearance.App.SimContentCardView" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="SimContentCardViewText">
        <item name="android:textColor">@color/background_sim_step_card_title</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:layout_marginHorizontal">@dimen/horizontal_margin</item>
    </style>

    <style name="SimContentCardTargetViewTitle" parent="SimContentCardViewText">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SimContentCardViewContent" parent="SimContentCardViewText">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SimSwitch">
        <item name="thumbTint">@color/sim_switch_thumb_color</item>
        <item name="trackTint">@color/sim_text_input_box_color</item>
    </style>

    <style name="SwitchCompatStyle">
        <item name="android:thumb">@color/switch_overlay_color_thumb</item>
        <item name="android:thumbTint">@color/switch_overlay_color_thumb</item>
    </style>

    <!-- Dug -->
    <style name="Dug.CardItem" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:layout_marginRight">8dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="DugLottieAnimation">
        <item name="android:scaleType">fitCenter</item>
        <item name="lottie_autoPlay">true</item>
        <item name="lottie_loop">true</item>
    </style>

    <!-- Mood detection -->

    <style name="MoodDetectionItemIcon">
        <item name="android:padding">4dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="shapeAppearanceOverlay">@style/circleImageView</item>
        <item name="contentPadding">4dp</item>
    </style>

    <style name="MoodDetectionItemIcon.Overlay" parent="MoodDetectionItemIcon">
        <item name="android:padding">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="TimePickerTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>

        <!-- Set PositiveButton color -->
        <item name="android:buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>

        <!-- Set NegativeButton color -->
        <item name="android:buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
    </style>

    <!-- Style for PositiveButton -->
    <style name="PositiveButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Style for NegativeButton -->
    <style name="NegativeButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/colorWarning</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">20%</item>
    </style>

    <style name="CustomDialog" parent="Theme.MaterialComponents.Dialog" >
        <item name="windowMinWidthMajor">95%</item>
        <item name="windowMinWidthMinor">95%</item>
    </style>

    <style name="FullWidth.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
