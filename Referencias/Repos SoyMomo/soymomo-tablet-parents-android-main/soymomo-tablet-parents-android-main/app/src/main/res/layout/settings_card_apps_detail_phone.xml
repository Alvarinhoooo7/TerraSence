<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/settings_card_design_white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/settings_card_design_white"
        android:elevation="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="8dp"
        android:padding="8dp">

        <ImageView
            android:id="@+id/lock_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/settings_blocks_lock_open"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/app_status_label"
            style="@style/ParentControlAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_allowed_text"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/lock_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/app_status_switch" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/app_status_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toEndOf="@id/app_status_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
        </com.google.android.material.materialswitch.MaterialSwitch>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/time_limit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:cardCornerRadius="24dp"
        app:strokeColor="@color/colorPrimary"
        app:strokeWidth="1dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintTop_toBottomOf="@id/app_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:paddingVertical="8dp"
            android:paddingHorizontal="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="2">

            <ImageView
                android:id="@+id/time_limit_icon"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sand_clock"
                android:layout_weight="0.2">

            </ImageView>

            <TextView
                android:id="@+id/time_limit_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/text_add_time_limit"
                android:textSize="16sp"
                android:layout_gravity="center"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/colorPrimary"
                android:layout_weight="1.6">

            </TextView>

            <ImageView
                android:id="@+id/time_limit_add"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add_time_limit"
                android:layout_weight="0.2">

            </ImageView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_age"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        app:layout_constraintTop_toBottomOf="@+id/time_limit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="4dp"
        android:layout_marginHorizontal="8dp"
        android:padding="4dp">

        <TextView
            android:id="@+id/age"
            android:textSize="16sp"
            android:layout_width="0dp"
            android:textColor="@color/colorPrimary"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/settings_app_age"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginHorizontal="16dp"/>

        <TextView
            android:id="@+id/recommended_age"
            android:textColor="@color/colorPrimary"
            android:fontFamily="@font/poppins_bold"
            android:textSize="32sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="+12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/age"
            android:layout_marginHorizontal="16dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_age">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/colorGrey"
            app:cardCornerRadius="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/label_description_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_weight="0.1"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_description_note">

                    </ImageView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:textColor="@color/colorPrimary"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="14sp"
                        android:text="@string/title_app_description">

                    </TextView>

                </LinearLayout>

                <TextView
                    android:id="@+id/description"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/label_description_layout"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins"
                    android:layout_marginVertical="12dp"
                    android:text="@string/default_app_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                </TextView>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_dangers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/colorGrey"
            app:cardCornerRadius="32dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/card_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/label_dangers_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="18dp"
                        android:layout_weight="0.1"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_warning_primary">

                    </ImageView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:textColor="@color/colorPrimary"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="14sp"
                        android:text="@string/title_potential_dangers">

                    </TextView>

                </LinearLayout>

                <TextView
                    android:id="@+id/potential_dangers"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/label_dangers_layout"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins"
                    android:layout_marginVertical="12dp"
                    android:text="@string/default_potential_dangers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                </TextView>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/google_play"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_description"
        android:background="@drawable/settings_card_design_primary"
        android:elevation="4dp"
        android:layout_marginVertical="16dp"
        android:layout_marginHorizontal="8dp"
        android:padding="12dp">

        <ImageView
            android:id="@+id/google_play_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/ic_google_play"
            />

        <TextView
            android:id="@+id/google_play_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/button_google_play"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/white"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/google_play_icon"
            app:layout_constraintEnd_toStartOf="@id/details_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="24dp"
            />

        <ImageView
            android:id="@+id/details_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/detail_arrow_right_white" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/variable_bottom_description"
        style="@style/ParentControlVariableFragmentDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        android:text="@string/settings_apps_description"
        app:layout_constraintTop_toBottomOf="@id/google_play"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingTop="16dp"
        android:paddingHorizontal="28dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>

