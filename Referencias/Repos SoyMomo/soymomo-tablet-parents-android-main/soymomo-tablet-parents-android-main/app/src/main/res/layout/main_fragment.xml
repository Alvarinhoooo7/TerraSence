<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/colorPrimary"
    android:id="@+id/parentConstraintLayout">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/main_fragment_card">

        <androidx.cardview.widget.CardView
            android:id="@+id/map_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vertical_margin"
            android:layout_marginHorizontal="@dimen/horizontal_margin"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!--
          No-location overlay: a dimmed scrim shown over the map_card when the
          selected device has not reported a location. Constrained to exactly
          match map_card so the dim respects the card bounds/rounded corners.
          Clickable so it absorbs touches on the (meaningless) map underneath.
          Toggled in MainFragment.renderMapForTablet().
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/map_no_location_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_map_scrim"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:elevation="8dp"
            android:outlineProvider="background"
            app:layout_constraintTop_toTopOf="@id/map_card"
            app:layout_constraintBottom_toBottomOf="@id/map_card"
            app:layout_constraintStart_toStartOf="@id/map_card"
            app:layout_constraintEnd_toEndOf="@id/map_card"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/horizontal_margin"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/main_bar_location"
                    app:tint="@color/white" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/map_no_location_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin_small"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:text="@string/main_map_no_location_title"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/map_no_location_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:text="@string/main_map_no_location_message"
                    android:textColor="@color/white_70"
                    android:textSize="14sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/map_button_my_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            app:backgroundTint="@color/colorAccent"
            app:tint="@color/white"
            app:fabSize="mini"
            android:src="@drawable/my_location"
            android:layout_marginHorizontal="@dimen/horizontal_margin_small"
            android:layout_marginVertical="@dimen/vertical_margin_small"
            app:layout_constraintBottom_toBottomOf="@id/map_card"
            app:layout_constraintEnd_toEndOf="@id/map_card"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
