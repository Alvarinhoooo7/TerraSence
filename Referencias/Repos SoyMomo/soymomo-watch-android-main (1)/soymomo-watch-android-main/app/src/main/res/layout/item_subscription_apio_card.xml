<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/apio_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:cardBackgroundColor="@color/black"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    tools:background="@color/background_onboarding"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/vertical_margin">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/apio_card_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="16sp"
            android:ellipsize="end"
            android:maxLines="3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/apio_card_logo"
            tools:text="Credit"
            tools:textSize="24sp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/apio_card_logo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            tools:srcCompat="@drawable/bank_card_visa"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent=".3"
            app:layout_constraintDimensionRatio="1" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/apio_card_chip"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:srcCompat="@drawable/credit_card_chip"
            app:layout_constraintTop_toBottomOf="@id/apio_card_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent=".16"
            app:layout_constraintDimensionRatio="1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/apio_card_digits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="16sp"
            android:ellipsize="end"
            android:maxLines="3"
            android:layout_marginBottom="@dimen/vertical_margin_small"
            app:layout_constraintBottom_toTopOf="@id/apio_card_username"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="XXXXXXXXXXXX6623"
            tools:textSize="32sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/apio_card_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:autoSizeTextType="uniform"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="16sp"
            android:ellipsize="end"
            android:maxLines="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Francisco Ordenes"
            tools:textSize="32sp" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>