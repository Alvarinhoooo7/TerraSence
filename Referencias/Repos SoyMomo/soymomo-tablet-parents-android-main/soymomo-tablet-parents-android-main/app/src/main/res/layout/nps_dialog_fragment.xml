<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="npsdialog"
            type="com.sosmartlabs.momotabletpadres.nps.NPSDialog" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:translationY="30dp">

        <ImageView
            android:id="@+id/nps_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="4dp"
            android:src="@drawable/ic_nps_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/close_nps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/nps_close"
            android:elevation="4dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-40dp"
            app:layout_constraintTop_toTopOf="@id/linearLayoutCompat"
            app:layout_constraintEnd_toEndOf="@id/linearLayoutCompat" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:translationY="-60dp"
            android:id="@+id/linearLayoutCompat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nps_image">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nps_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/momo_background"
                app:cardCornerRadius="32dp"
                app:contentPaddingTop="70dp"
                app:contentPaddingBottom="20dp"
                app:contentPaddingLeft="20dp"
                app:contentPaddingRight="20dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:maxEms="15"
                        android:text="@string/nps_title"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <GridView
                        android:id="@+id/grid_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:numColumns="5"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="16dp"
                        app:contentPadding="8dp">

                        <EditText
                            android:id="@+id/user_comment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:gravity="top"
                            android:lines="3"
                            android:text="@={npsdialog.userComment}"
                            android:textColor="@color/momo_background"
                            android:textColorHint="@color/momo_text_hint"
                            android:textSize="14sp" />
                    </com.google.android.material.card.MaterialCardView>


                    <Button
                        android:id="@+id/submit"
                        style="@style/NegativeWideButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nps_send" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </com.google.android.material.card.MaterialCardView>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>