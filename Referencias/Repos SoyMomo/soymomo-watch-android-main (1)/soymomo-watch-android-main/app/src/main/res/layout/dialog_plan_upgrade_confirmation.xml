<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/horizontal_margin">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="@dimen/card_elevation">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/horizontal_margin">

                <TextView
                    android:id="@+id/dialog_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/subscription_plan_upgrade_confirm_title"
                    android:textColor="@color/background_sim_step_card_title"
                    android:textSize="24sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selected_plan_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin"
                    app:cardBackgroundColor="@color/sim_upgrade_entry_background"
                    app:cardCornerRadius="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dialog_title">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="96dp"
                        android:padding="16dp">

                        <FrameLayout
                            android:id="@+id/plan_logo_container"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@color/colorPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/plan_logo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="6dp"
                                app:srcCompat="@drawable/ic_soymomo_sim"
                                tools:ignore="ContentDescription" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/plan_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/background_sim_step_card_title"
                            android:textSize="20sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/plan_logo_container"
                            app:layout_constraintTop_toTopOf="@id/plan_logo_container"
                            tools:text="Smart Plan" />

                        <TextView
                            android:id="@+id/plan_price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/robotomedium"
                            android:textColor="@color/background_sim_step_card_title"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/plan_logo_container"
                            app:layout_constraintTop_toBottomOf="@id/plan_title"
                            tools:text="$15.990" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/checkbox_tc"
                    style="@style/SimSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin_large"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/selected_plan_card" />

                <TextView
                    android:id="@+id/text_view_tc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/vertical_margin_small"
                    android:fontFamily="@font/poppins"
                    android:text="@string/subscription_form_label_checkboxes_tc"
                    android:textColor="@color/background_sim_step_card_title"
                    android:textSize="@dimen/add_watch_form_label"
                    app:layout_constraintBottom_toBottomOf="@id/checkbox_tc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/checkbox_tc"
                    app:layout_constraintTop_toTopOf="@id/checkbox_tc" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/checkbox_np"
                    style="@style/SimSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin_small"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/checkbox_tc" />

                <TextView
                    android:id="@+id/text_view_np"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/vertical_margin_small"
                    android:fontFamily="@font/poppins"
                    android:text="@string/subscription_form_label_checkboxes_pc"
                    android:textColor="@color/background_sim_step_card_title"
                    android:textSize="@dimen/add_watch_form_label"
                    app:layout_constraintBottom_toBottomOf="@id/checkbox_np"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/checkbox_np"
                    app:layout_constraintTop_toTopOf="@id/checkbox_np" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_cancel"
                    style="@style/SimButton.Negative"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/vertical_margin_large"
                    android:layout_marginEnd="8dp"
                    android:text="@string/button_cancel"
                    app:layout_constraintEnd_toStartOf="@id/button_confirm"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/checkbox_np" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_confirm"
                    style="@style/SimButton.Positive"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="@dimen/vertical_margin_large"
                    android:text="@string/subscription_plan_upgrade_confirm_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/button_cancel"
                    app:layout_constraintTop_toBottomOf="@id/checkbox_np" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
