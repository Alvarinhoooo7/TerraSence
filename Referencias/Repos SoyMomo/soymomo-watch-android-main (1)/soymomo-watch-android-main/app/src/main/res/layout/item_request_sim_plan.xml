<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/plan_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/vertical_margin_small"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeColor="@color/background_sim_step_card_title"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/horizontal_margin"
        android:paddingEnd="@dimen/horizontal_margin"
        android:paddingTop="@dimen/horizontal_margin"
        android:paddingBottom="@dimen/vertical_margin_small">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/plan_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/background_sim_step_card_title"
            android:textStyle="bold"
            android:textSize="24sp"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="SoyMomo Plan" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/plan_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/background_sim_step_card_title"
            android:textStyle="bold"
            android:textSize="32sp"
            app:layout_constraintTop_toBottomOf="@id/plan_title"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="$9.990" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/plan_striked_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/background_sim_step_card_title"
            android:textSize="24sp"
            app:layout_constraintBaseline_toBaselineOf="@id/plan_price"
            app:layout_constraintStart_toEndOf="@id/plan_price"
            android:layout_marginStart="@dimen/horizontal_margin_small"
            tools:text="$12.990" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/plan_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vertical_margin"
            android:layout_marginBottom="0dp"
            android:paddingStart="@dimen/horizontal_margin_medium"
            android:fontFamily="@font/poppins"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            app:layout_constraintTop_toBottomOf="@id/plan_striked_price"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="• Data: 10 GB\n• Voice: Unlimited\n• Warranty: 1 year"
            tools:ignore="RtlSymmetry" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

