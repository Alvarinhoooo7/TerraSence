<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".sim.ui.fragments.transfer.SubscriptionTransferListFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:collapsedTitleTextAppearance="@style/CollapsingToolbarCollapsed"
            app:contentScrim="@color/colorPrimary"
            app:expandedTitleTextAppearance="@style/CollapsingToolbarExpanded"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header"
                style="@style/SimStepCardHeader.Over"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax"
                app:layout_scrollFlags="scroll|enterAlwaysCollapsed">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/app_bar_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="?attr/actionBarSize" />

                <include
                    android:id="@+id/header_plan_info"
                    layout="@layout/item_sim_plan_small"
                    android:layout_width="0dp"
                    android:layout_height="128dp"
                    app:layout_constraintDimensionRatio="2:1"
                    android:layout_marginHorizontal="@dimen/horizontal_margin_extra_large"
                    android:layout_marginBottom="@dimen/vertical_margin"
                    app:layout_constraintTop_toBottomOf="@id/app_bar_guide"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/background_sim_step_card_title"
                android:theme="@style/ToolbarTheme"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:transitionGroup="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/white">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/subscription_settings_label"
                style="@style/SimContentCardTargetViewTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/vertical_margin_large"
                android:text="@string/subscription_detail_transfer_title"
                android:textAlignment="viewStart"
                android:textColor="@color/background_sim_step_card_title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/subscription_settings_label">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/transfer_to_new_sim_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin_small"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    style="@style/SimContentCardView">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/transfer_to_new_sim_card_image"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:srcCompat="@drawable/ic_sim_transfer_to_sim"
                            android:layout_margin="@dimen/vertical_margin_small"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/transfer_to_new_sim_card_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_arrow_go"
                            android:layout_margin="@dimen/vertical_margin"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/transfer_to_new_sim_card_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/subscription_detail_transfer_to_new_sim"
                            android:textStyle="bold"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/transfer_to_new_sim_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/transfer_to_new_sim_card_arrow"
                            app:layout_constraintBottom_toTopOf="@+id/transfer_to_new_sim_card_subtitle"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/transfer_to_new_sim_card_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/subscription_detail_transfer_to_new_sim_description"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toBottomOf="@+id/transfer_to_new_sim_card_title"
                            app:layout_constraintStart_toEndOf="@+id/transfer_to_new_sim_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/transfer_to_new_sim_card_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/transfer_to_new_watch_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin_small"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    style="@style/SimContentCardView">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/transfer_to_new_watch_card_image"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:srcCompat="@drawable/ic_sim_transfer_to_watch"
                            android:layout_margin="@dimen/vertical_margin_small"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/transfer_to_new_watch_card_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_arrow_go"
                            android:layout_margin="@dimen/vertical_margin"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/transfer_to_new_watch_card_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/subscription_detail_transfer_to_new_watch"
                            android:textStyle="bold"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/transfer_to_new_watch_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/transfer_to_new_watch_card_arrow"
                            app:layout_constraintBottom_toTopOf="@+id/transfer_to_new_watch_card_subtitle"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/transfer_to_new_watch_card_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/subscription_detail_transfer_to_new_watch_description"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toBottomOf="@+id/transfer_to_new_watch_card_title"
                            app:layout_constraintStart_toEndOf="@+id/transfer_to_new_watch_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/transfer_to_new_watch_card_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>