<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/link_watch_background"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_kid_profile_form"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/link_watch_title_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/LinkWatchTitleTextPurple"
                    android:text="@string/link_watch_steps_title"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                </TextView>

                <ImageView
                    android:id="@+id/vertical_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/link_watch_title_textview"
                    android:src="@drawable/vertical_divider_linkwatch_state0"
                    android:layout_marginTop="36dp">

                </ImageView>

                <include
                    android:id="@+id/linkstep_cardview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    layout="@layout/linkwatch_cardview_mainview_scanwatch"
                    app:layout_constraintStart_toEndOf="@id/vertical_divider"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/vertical_divider"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="-4dp">

                </include>

                <include
                    android:id="@+id/admindata_cardview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    layout="@layout/linkwatch_cardview_mainview_admindata"
                    app:layout_constraintStart_toStartOf="@id/linkstep_cardview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/linkstep_cardview"
                    android:layout_marginTop="12dp">

                </include>

                <include
                    android:id="@+id/childdata_cardview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    layout="@layout/linkwatch_cardview_mainview_childdata"
                    app:layout_constraintStart_toStartOf="@id/linkstep_cardview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/admindata_cardview"
                    android:layout_marginTop="12dp">

                </include>

                <include
                    android:id="@+id/simcard_cardview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    layout="@layout/linkwatch_cardview_mainview_simcard"
                    app:layout_constraintStart_toStartOf="@id/linkstep_cardview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/childdata_cardview"
                    android:layout_marginTop="12dp">

                </include>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/link_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/simcard_cardview"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textAllCaps="false"
                    app:cornerRadius="32dp"
                    android:fontFamily="@font/poppins"
                    android:text="@string/link"
                    android:backgroundTint="@color/watch_settings_green_button"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold">

                </com.google.android.material.button.MaterialButton>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>