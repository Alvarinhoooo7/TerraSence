<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:strokeWidth="0dp"
    android:elevation="0dp"
    app:strokeColor="@color/white">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/day"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/settings_card_design_secondary"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:paddingVertical="@dimen/vertical_margin_smallest"
        android:paddingHorizontal="@dimen/horizontal_margin"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:layout_marginVertical="@dimen/vertical_margin"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.35"
        tools:text="Lunes" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/from_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/poppins"
        android:text="@string/usage_hours_range_from"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/day"
        app:layout_constraintStart_toEndOf="@id/day"
        app:layout_constraintTop_toTopOf="@id/day" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/from_time_set"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin_small"
        android:maxLines="1"
        android:textSize="14sp"
        android:paddingVertical="4dp"
        android:fontFamily="@font/poppins_bold"
        android:background="@drawable/settings_card_design_primary"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="@id/from_text"
        app:layout_constraintBottom_toBottomOf="@id/from_text"
        app:layout_constraintStart_toEndOf="@id/from_text"
        tools:text="8h00m" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/to_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/poppins"
        android:text="@string/usage_hours_range_to"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@id/to_time_set"
        app:layout_constraintBottom_toBottomOf="@id/to_time_set"
        app:layout_constraintStart_toStartOf="@id/from_text"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/to_time_set"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin_small"
        android:layout_marginTop="@dimen/vertical_margin_small"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:maxLines="1"
        android:textSize="14sp"
        android:paddingVertical="4dp"
        android:fontFamily="@font/poppins_bold"
        android:background="@drawable/settings_card_design_primary"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        app:layout_constraintStart_toStartOf="@id/from_time_set"
        app:layout_constraintTop_toBottomOf="@id/from_time_set"
        app:layout_constraintEnd_toEndOf="@id/from_time_set"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="8h00m" />

</androidx.constraintlayout.widget.ConstraintLayout>