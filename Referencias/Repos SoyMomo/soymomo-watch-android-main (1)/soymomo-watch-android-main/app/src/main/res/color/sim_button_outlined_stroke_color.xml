<?xml version="1.0" encoding="utf-8"?>
<!-- Outline counterpart of sim_button_outlined_text_color: the stroke must grey out with
     the label, or a disabled button keeps a full-strength border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"
        android:color="@color/sim_button_disabled_tint" />
    <item android:color="@color/sim_button_positive" />
</selector>
