<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detection_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="@dimen/dug_card_spacing"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dug_card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/dug_card_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dug_card_padding">

        <!-- Row 1: Category icon + label + timestamp -->
        <ImageView
            android:id="@+id/category_icon"
            android:layout_width="@dimen/dug_card_category_icon_size"
            android:layout_height="@dimen/dug_card_category_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_dug_detection_search"
            app:layout_constraintBottom_toBottomOf="@id/category_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/category_label" />

        <TextView
            android:id="@+id/category_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/poppins"
            android:text="@string/dug_category_searches"
            android:textColor="@color/dug_text_metadata"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/timestamp"
            app:layout_constraintStart_toEndOf="@id/category_icon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Searches" />

        <TextView
            android:id="@+id/timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:textColor="@color/dug_text_metadata"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/category_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/category_label"
            tools:text="1:30 PM" />

        <!-- Row 2: App icon + app name / search text -->
        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="@dimen/dug_card_app_icon_size"
            android:layout_height="@dimen/dug_card_app_icon_size"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/category_label"
            tools:src="@drawable/ic_dug_detection_search" />

        <TextView
            android:id="@+id/app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:textColor="@color/dug_text_primary"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/search_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/app_icon"
            app:layout_constraintTop_toTopOf="@id/app_icon"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Google Chrome" />

        <TextView
            android:id="@+id/search_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="2"
            android:textColor="@color/dug_text_body"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/app_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/app_icon"
            app:layout_constraintTop_toBottomOf="@id/app_name"
            tools:text="how to bypass parental controls" />

        <!-- Row 3: Category chip -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_icon"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/category_chip"
                style="@style/Dug.Chip.Tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="Violence"
                tools:visibility="visible" />

        </com.google.android.material.chip.ChipGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
