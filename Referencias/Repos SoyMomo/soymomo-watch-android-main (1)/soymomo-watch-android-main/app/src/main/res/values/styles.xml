         crash). Required on every MaterialSwitch in a measured RecyclerView row. -->
    <style name="SimSwitch">
        <item name="thumbTint">@color/sim_switch_thumb_color_m3</item>
        <item name="trackTint">@color/sim_text_input_box_color</item>
        <item name="showText">false</item>
