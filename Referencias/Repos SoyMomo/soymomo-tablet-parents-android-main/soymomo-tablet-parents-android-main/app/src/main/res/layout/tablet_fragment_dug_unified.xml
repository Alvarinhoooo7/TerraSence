<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <!-- Compact gradient header: 80dp fixed height -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dug_header_height"
        android:background="@color/colorPrimary"
        android:paddingStart="8dp"
        android:paddingEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_button"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_backward"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/dug_icon"
            android:layout_width="@dimen/dug_header_icon_size"
            android:layout_height="@dimen/dug_header_icon_size"
            android:layout_marginStart="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_dug"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/back_button"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:alpha="0.7"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:text="@string/dug_unified_hero_title"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            app:layout_constraintBottom_toTopOf="@+id/hero_count"
            app:layout_constraintEnd_toStartOf="@+id/monitoring_badge"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/dug_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/hero_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/monitoring_badge"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/dug_icon"
            app:layout_constraintTop_toBottomOf="@+id/hero_title"
            tools:text="12 detections" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/monitoring_badge"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingVertical="0dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            app:backgroundTint="@color/dug_badge_bg"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_settings_black_24dp"
            app:iconSize="16dp"
            app:iconTint="@android:color/white"
            app:iconGravity="start"
            app:iconPadding="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="5/5 active" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- White content area with rounded top corners -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/settings_card_design_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <!-- Filter chips -->
        <HorizontalScrollView
            android:id="@+id/filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filter_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacing="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_all"
                    style="@style/Dug.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/dug_filter_all"
                    app:chipIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_images"
                    style="@style/Dug.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dug_chip_images"
                    app:chipIcon="@drawable/ic_dug_detection_images" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_messages"
                    style="@style/Dug.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dug_chip_messages"
                    app:chipIcon="@drawable/ic_dug_detection_messages" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_searches"
                    style="@style/Dug.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dug_chip_searches"
                    app:chipIcon="@drawable/ic_dug_detection_search" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_mood"
                    style="@style/Dug.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dug_detection_mood_title"
                    app:chipIcon="@drawable/ic_dug_detection_moods" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_music"
                    style="@style/Dug.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dug_chip_music"
                    app:chipIcon="@drawable/ic_dug_detection_music" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- ViewFlipper for states -->
        <ViewFlipper
            android:id="@+id/view_flipper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/filter_scroll">

            <!-- Child 0: Populated -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/unified_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp"
                tools:itemCount="5"
                tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_dug_detection_message"
                tools:orientation="vertical" />

            <!-- Child 1: Empty state -->
            <include
                android:id="@+id/view_no_detections"
                layout="@layout/layout_dug_empty_state" />

            <!-- Child 2: Loading -->
            <include
                android:id="@+id/view_loading"
                layout="@layout/view_generic_loading_bar" />

        </ViewFlipper>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
