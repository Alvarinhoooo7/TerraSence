<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_card_design_white"
    android:layout_marginHorizontal="@dimen/horizontal_margin"
    android:layout_marginVertical="@dimen/vertical_margin"
    android:paddingLeft="@dimen/horizontal_margin"
    android:paddingTop="@dimen/vertical_margin"
    android:paddingRight="@dimen/horizontal_margin"
    android:paddingBottom="@dimen/vertical_margin">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_block_website"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/settings_blocks_web_disable"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/text_title_website" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_title_website"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/vertical_margin_small"
            android:text="@string/dialog_block_website_text"
            style="@style/ParentControlVariableFragmentTitle"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/image_block_website"
            app:layout_constraintBottom_toTopOf="@+id/button_cancel_website"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_website"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/button_cancel"
            android:textAllCaps="false"
            style="@style/ParentControlButtonText"
            app:backgroundTint="@color/colorAccept"
            app:cornerRadius="@dimen/button_corner_radius"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/button_delete_website"
            app:layout_constraintTop_toBottomOf="@+id/text_title_website"
            android:layout_marginHorizontal="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_website"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/settings_block_web_disable"
            android:textAllCaps="false"
            style="@style/ParentControlButtonText"
            app:backgroundTint="@color/colorCancel"
            app:cornerRadius="@dimen/button_corner_radius"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/button_cancel_website"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/button_cancel_website"
            android:layout_marginHorizontal="4dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>