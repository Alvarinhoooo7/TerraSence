<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".linkwatch.ui.fragments.LinkStepFragment">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/link_button"
        android:background="@color/white">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transparent">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:collapsedTitleTextAppearance="@style/CollapsingToolbarCollapsed"
                app:contentScrim="@color/link_watch_background"
                app:expandedTitleTextAppearance="@style/CollapsingToolbarExpanded"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/header"
                    style="@style/LinkStepCardHeader.Over"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="parallax"
                    app:layout_scrollFlags="scroll|enterAlwaysCollapsed">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/app_bar_guide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_begin="?attr/actionBarSize">

                    </androidx.constraintlayout.widget.Guideline>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/link_first_step_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/app_bar_guide"
                        app:layout_constraintBottom_toTopOf="@+id/link_first_step_title_textview"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginVertical="@dimen/vertical_margin_small">

                    </com.google.android.material.imageview.ShapeableImageView>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/link_first_step_title_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_soymomo_title"
                        style="@style/LinkWatchTitleText"
                        app:layout_constraintTop_toBottomOf="@id/link_first_step_image"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginVertical="@dimen/vertical_margin">

                    </com.google.android.material.textview.MaterialTextView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@color/link_watch_background"
                    android:theme="@style/ToolbarTheme"
                    app:layout_collapseMode="pin">

                </androidx.appcompat.widget.Toolbar>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:transitionGroup="true"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/link_first_step_description_textview"
                    style="@style/LinkWatchDescriptionTextPurple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:layout_marginVertical="@dimen/vertical_margin_large"
                    android:text="@string/link_step_description"
                    app:layout_constraintBottom_toTopOf="@id/imei_textinput"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                </com.google.android.material.textview.MaterialTextView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/imei_textinput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/imei_textinput"
                    style="@style/Widget.App.TextInputLayout.PurpleColoredBox.NotCurved"
                    app:layout_constraintTop_toBottomOf="@id/link_first_step_description_textview"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    app:endIconMode="custom"
                    app:endIconTint="@color/white"
                    app:endIconTintMode="multiply"
                    app:counterEnabled="true"
                    app:counterMaxLength="15"
                    app:endIconDrawable="@drawable/ic_camera">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/link_watch_background">

                    </com.google.android.material.textfield.TextInputEditText>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_indicator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp"
                    android:elevation="16dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/white"
                    app:trackColor="@color/background_sim_step_card_title"
                    app:layout_constraintTop_toBottomOf="@+id/imei_textinput"
                    app:layout_constraintStart_toStartOf="@id/imei_textinput"
                    app:layout_constraintEnd_toEndOf="@id/imei_textinput"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <ViewFlipper
                    android:id="@+id/link_step_viewflipper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    app:layout_constraintTop_toBottomOf="@id/imei_textinput"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/select_watch_title"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:text="@string/select_color_link_step"
                            style="@style/LinkWatchDescriptionTextPurple"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        </com.google.android.material.textview.MaterialTextView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/pink_watch_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:strokeWidth="1dp"
                            app:cardElevation="0dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:checkable="true"
                            app:strokeColor="@color/black_10"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.25"
                            app:layout_constraintTop_toBottomOf="@id/select_watch_title"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginVertical="@dimen/vertical_margin_small"
                            android:layout_marginHorizontal="@dimen/horizontal_margin"
                            app:cardCornerRadius="24dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/pink_watch_imageview"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:srcCompat="@drawable/pink_watch_img"
                                    android:layout_margin="8dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                </com.google.android.material.imageview.ShapeableImageView>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/lightblue_watch_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:strokeWidth="1dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/black_10"
                            android:clickable="true"
                            android:focusable="true"
                            android:checkable="true"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.25"
                            app:layout_constraintTop_toBottomOf="@id/select_watch_title"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginVertical="@dimen/vertical_margin_small"
                            app:cardCornerRadius="24dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:srcCompat="@drawable/lightblue_watch_img"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                </com.google.android.material.imageview.ShapeableImageView>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/black_watch_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:strokeWidth="1dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/black_10"
                            android:clickable="true"
                            android:focusable="true"
                            android:checkable="true"
                            app:layout_constraintWidth_default="percent"
                            app:layout_constraintWidth_percent="0.25"
                            app:layout_constraintTop_toBottomOf="@id/select_watch_title"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginVertical="@dimen/vertical_margin_small"
                            android:layout_marginHorizontal="@dimen/horizontal_margin"
                            app:cardCornerRadius="24dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:srcCompat="@drawable/black_watch_img"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                </com.google.android.material.imageview.ShapeableImageView>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="@color/link_step_background">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/icon_error"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:srcCompat="@drawable/ic_error">

                            </com.google.android.material.imageview.ShapeableImageView>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/error_description"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toEndOf="@id/icon_error"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:text="@string/imei_error_text"
                                style="@style/LinkWatchDescriptionText"
                                android:textColor="@color/error_text_color"
                                android:textSize="@dimen/hint_text_size"
                                android:layout_marginHorizontal="@dimen/horizontal_margin_smallest">

                            </com.google.android.material.textview.MaterialTextView>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="@color/link_step_background">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/icon_net"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:srcCompat="@drawable/ic_net">

                            </com.google.android.material.imageview.ShapeableImageView>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/net_error_description"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toEndOf="@id/icon_net"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:text="@string/net_error_text"
                                style="@style/LinkWatchDescriptionText"
                                android:textColor="@color/error_text_color"
                                android:textSize="@dimen/hint_text_size"
                                android:layout_marginHorizontal="@dimen/horizontal_margin_smallest">

                            </com.google.android.material.textview.MaterialTextView>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="@color/link_step_background">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/icon_already_linked"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:srcCompat="@drawable/ic_error">

                            </com.google.android.material.imageview.ShapeableImageView>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/already_linked_error_description"
                                style="@style/LinkWatchDescriptionText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/horizontal_margin_smallest"
                                android:text="@string/error_already_linked_status"
                                android:textColor="@color/error_text_color"
                                android:textSize="@dimen/hint_text_size"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/icon_already_linked"
                                app:layout_constraintTop_toTopOf="parent">

                            </com.google.android.material.textview.MaterialTextView>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                </ViewFlipper>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/link_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/icon_hint"
        android:textAllCaps="false"
        app:cornerRadius="32dp"
        android:fontFamily="@font/poppins"
        android:enabled="false"
        android:text="@string/completed_string"
        android:backgroundTint="@color/not_available_button_color"
        android:layout_marginVertical="@dimen/vertical_margin"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        android:textStyle="bold">

    </com.google.android.material.button.MaterialButton>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/icon_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/link_step_hint_text"
        android:layout_marginHorizontal="@dimen/horizontal_margin">

    </com.google.android.material.imageview.ShapeableImageView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/link_step_hint_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/link_step_hint"
        style="@style/LinkWatchDescriptionTextPurple"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        android:textSize="@dimen/hint_text_size">

    </com.google.android.material.textview.MaterialTextView>

</androidx.constraintlayout.widget.ConstraintLayout>
