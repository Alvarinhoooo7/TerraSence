<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_upgrade_popup_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/horizontal_margin"
            android:paddingEnd="@dimen/horizontal_margin"
            android:paddingTop="@dimen/vertical_margin"
            android:paddingBottom="@dimen/vertical_margin">

            <!-- Header: logo + close -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/upgrade_popup_logo"
                    android:layout_width="180dp"
                    android:layout_height="56dp"
                    android:scaleType="fitStart"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_soymomo_logo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/upgrade_popup_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/button_cancel"
                    app:srcCompat="@drawable/ic_close"
                    app:tint="@color/momoFont"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Title -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/upgrade_popup_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/upgrade_plan_popup_title"
                android:textColor="@color/momoFont"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- Subtitle (with inline <b>) -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/upgrade_popup_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_small"
                android:fontFamily="@font/poppins"
                android:textColor="@color/momoFont"
                android:textSize="16sp"
                tools:text="**Activa un plan superior** y accede a todo lo que te estás perdiendo." />

            <!-- Bullet pills -->
            <LinearLayout
                android:id="@+id/upgrade_popup_bullets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin"
                android:orientation="vertical">

                <include
                    android:id="@+id/upgrade_popup_bullet_starting_price"
                    layout="@layout/item_upgrade_popup_bullet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/upgrade_popup_bullet_data"
                    layout="@layout/item_upgrade_popup_bullet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <include
                    android:id="@+id/upgrade_popup_bullet_voice"
                    layout="@layout/item_upgrade_popup_bullet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <include
                    android:id="@+id/upgrade_popup_bullet_warranty"
                    layout="@layout/item_upgrade_popup_bullet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- Spacer pushes CTA to the bottom of the dialog -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/upgrade_popup_cta_button"
                style="@style/SimButton.Positive"
                android:layout_width="match_parent"
                android:layout_height="@dimen/first_momo_button_height"
                android:layout_marginTop="@dimen/vertical_margin"
                android:text="@string/upgrade_plan_popup_button_label"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="@color/momoFont"
                android:textColor="@android:color/white" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
