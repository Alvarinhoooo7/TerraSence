<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/horizontal_margin_smallest"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            style="@style/contactImageView"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:id="@+id/selector_profile_picture"
            android:layout_width="@dimen/watch_selector_profile_picture_size"
            android:layout_height="@dimen/watch_selector_profile_picture_size"
            tools:srcCompat="@drawable/momo_picture_default" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>