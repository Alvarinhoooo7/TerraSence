<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".chat.presentation.fragment.UnifiedChatFragment">

    <!-- Main Chat Layout Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_sim_step_card_title"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Chat Header Bar with Toolbar and Avatar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/background_sim_step_card_title"
            app:layout_constraintBottom_toTopOf="@id/chatRecyclerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Toolbar with Navigation and Header -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:theme="@style/ToolbarTheme"
                app:contentInsetStartWithNavigation="0dp"
                app:contentInsetStart="0dp"
                app:navigationIcon="@drawable/ic_arrow_back_24">

                <!-- Header Container with Avatar, Title, Subtitle, and Video Call Button -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/headerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <!-- Chat Avatar (Group or Individual) -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/chatAvatarImageView"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginVertical="8dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintDimensionRatio="1:1"
                        app:shapeAppearanceOverlay="@style/CircularImageView"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:src="@drawable/ic_group_avatar_white_stroke" />

                    <!-- Chat Title (Group name or Contact name) -->
                    <TextView
                        android:id="@+id/chatTitleTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_small"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:maxLines="1"
                        app:layout_constraintTop_toTopOf="@+id/chatAvatarImageView"
                        app:layout_constraintEnd_toStartOf="@+id/videoCallButton"
                        app:layout_constraintStart_toEndOf="@+id/chatAvatarImageView"
                        app:layout_constraintBottom_toTopOf="@id/chatSubtitleTextView"
                        tools:text="Family Group"
                        tools:visibility="visible"/>

                    <!-- Chat Subtitle (Member count or Last seen) -->
                    <TextView
                        android:id="@+id/chatSubtitleTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/white_70"
                        android:textSize="13sp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        app:layout_constraintStart_toStartOf="@id/chatTitleTextView"
                        app:layout_constraintEnd_toEndOf="@id/chatTitleTextView"
                        app:layout_constraintTop_toBottomOf="@+id/chatTitleTextView"
                        app:layout_constraintBottom_toBottomOf="@+id/chatAvatarImageView"
                        tools:text="5 members"
                        tools:visibility="visible"/>

                    <!-- Video Call Button (shown for individual chats with video support) -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/videoCallButton"
                        android:layout_width="56dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="@dimen/horizontal_margin_small"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/videocall_button"
                        android:visibility="gone" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Chat Messages RecyclerView (reverse layout, shows newest messages at bottom) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingHorizontal="18dp"
            app:layout_constraintBottom_toTopOf="@+id/chatBottomActionsBarrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/appbar"
            app:reverseLayout="true"
            app:stackFromEnd="true"
            android:background="@drawable/background_shape_upper_rounded_white"/>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/chatBottomActionsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:barrierAllowsGoneWidgets="false"
            app:constraint_referenced_ids="actionsLayout,disconnected_actions_layout" />

        <!-- Bottom White Background Layout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/chatBottomActionsBarrier"
            android:background="@color/white"/>

        <!-- Message Input Actions Layout (contains FABs, input field, and media controls) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/actionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="@dimen/vertical_margin_small"
            android:layout_marginHorizontal="@dimen/horizontal_margin_small"
            tools:visibility="invisible">

            <!-- Send Message FAB (visible when typing) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatFab"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                app:iconPadding="0dp"
                app:iconGravity="textEnd"
                android:backgroundTint="@color/background_sim_step_card_title"
                app:cornerRadius="28dp"
                app:icon="@drawable/chat_send"
                app:iconTint="@color/white"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Voice Message FAB (visible when in voice recording mode) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatAudio"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                app:iconPadding="0dp"
                app:iconGravity="textEnd"
                app:icon="@drawable/chat_mic"
                app:backgroundTint="@color/background_sim_step_card_title"
                app:cornerRadius="28dp"
                app:iconTint="@color/white"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Input Field Switcher (Text input or Voice recording UI) -->
            <ViewSwitcher
                android:id="@+id/chatMessageViewSwitcher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/horizontal_margin_smallest"
                android:layout_marginEnd="@dimen/horizontal_margin_smallest"
                android:inAnimation="@anim/slide_in_right"
                android:minHeight="32dp"
                app:layout_constraintBottom_toBottomOf="@id/chatFab"
                app:layout_constraintEnd_toStartOf="@id/chatFab"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/chatFab">

                <!-- Text Message Input Layout -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/chatLayoutMessageText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                        android:background="@drawable/bg_chat_input">

                    <!-- Text Message EditText Input Field -->
                    <EditText
                        android:id="@+id/chatEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        android:layout_marginVertical="@dimen/vertical_margin"
                        android:autofillHints=""
                        android:background="@null"
                        android:hint="@string/messages_enter_text"
                        android:textColorHint="@color/colorPrimaryLighter"
                        android:textColorHighlight="@color/white_30"
                        android:textColor="@color/white"
                        android:textCursorDrawable="@drawable/cursor_white"
                        android:textSelectHandle="@drawable/cursor_white"
                        android:textSelectHandleLeft="@drawable/cursor_white"
                        android:textSelectHandleRight="@drawable/cursor_white"
                        android:fontFamily="@font/roboto_regular"
                        android:includeFontPadding="false"
                        android:inputType="textMultiLine"
                        android:imeOptions="actionSend"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/chatSendImage"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Camera Attachment Button (opens camera/gallery selection) -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/chatSendImage"
                        android:layout_height="24dp"
                        android:layout_width="24dp"
                        app:tint="@color/white"
                        android:layout_marginEnd="@dimen/horizontal_margin"
                        android:layout_marginVertical="@dimen/vertical_margin_small"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/chatEditText"
                        app:srcCompat="@drawable/chat_camera"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Voice Message Recording Layout -->
                <LinearLayout
                    android:id="@+id/chatLayoutAudio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <!-- Recording Duration Display -->
                    <TextView
                        android:id="@+id/chatTextViewLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/background_sim_step_card_title"
                        android:textSize="24sp" />

                    <!-- Spacer -->
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <!-- Cancel Instruction Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/background_sim_step_card_title"
                        android:text="@string/messages_slide_to_cancel" />

                </LinearLayout>
            </ViewSwitcher>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Device disconnected layout (replaces message inputs) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/disconnected_actions_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="@dimen/vertical_margin_small"
            android:layout_marginHorizontal="@dimen/horizontal_margin_small"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/disconnected_actions_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/watch_disconnected"
                app:strokeWidth="0dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/momo_error_background"
                android:layout_marginHorizontal="@dimen/horizontal_margin_small"
                android:layout_marginVertical="@dimen/vertical_margin_smaller"
                app:cardCornerRadius="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/vertical_margin_small">

                    <!-- Cause glyph, swapped in UnifiedChatFragment from the same
                         Wearer.ranOutOfBattery() split the map banner and wearer card use.
                         Was a generic unplugged-plug for every cause; it also sat in a
                         32x32 box holding a 15x6dp vector, so 19dp of that slot was empty. -->
                    <ImageView
                        android:id="@+id/disconnected_actions_card_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:srcCompat="@drawable/no_sim"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_small"
                        android:importantForAccessibility="no"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/disconnected_actions_card_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/main_prompt_device_disconnected_title"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/disconnected_actions_card_subtitle"
                        app:layout_constraintStart_toEndOf="@+id/disconnected_actions_card_icon"
                        app:layout_constraintEnd_toStartOf="@+id/disconnected_actions_card_arrow"
                        android:layout_marginHorizontal="@dimen/vertical_margin" />

                    <TextView
                        android:id="@+id/disconnected_actions_card_subtitle"
                        android:textSize="13sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="textStart"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        tools:text="3 hr. ago"
                        app:layout_constraintTop_toBottomOf="@+id/disconnected_actions_card_title"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/disconnected_actions_card_icon"
                        app:layout_constraintEnd_toStartOf="@+id/disconnected_actions_card_arrow"
                        android:layout_marginHorizontal="@dimen/vertical_margin" />

                    <ImageView
                        android:id="@+id/disconnected_actions_card_arrow"
                        android:layout_width="12dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_arrow_go_white"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_small"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Full Screen Overlay (shown when selecting media attachments) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/screenOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white_30"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:elevation="4dp"
            android:visibility="gone"/>

        <!-- Back Arrow FAB (closes media selection overlay) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/chatSendImageArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            app:fabSize="mini"
            app:tint="@color/white"
            android:layout_marginBottom="4dp"
            android:backgroundTint="@color/colorPrimary"
            app:layout_constraintTop_toTopOf="@id/actionsLayout"
            app:layout_constraintBottom_toBottomOf="@id/actionsLayout"
            app:layout_constraintEnd_toEndOf="@id/chatSendFromCamera"
            app:layout_constraintStart_toStartOf="@id/chatSendFromCamera"
            app:srcCompat="@drawable/back_arrow"
            android:rotation="-90"
            app:borderWidth="0dp"
            android:elevation="100dp"
            android:visibility="gone" />

        <!-- Invisible Spacing FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/dummy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            app:backgroundTint="@color/linkwatch_red_button"
            app:fabSize="mini"
            app:tint="@color/white"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@id/actionsLayout"
            app:layout_constraintEnd_toEndOf="@id/actionsLayout"
            app:srcCompat="@drawable/ic_action_camera"
            android:visibility="invisible"/>

        <!-- Camera FAB (launches camera for photo capture) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/chatSendFromCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            app:backgroundTint="@color/linkwatch_red_button"
            app:fabSize="auto"
            app:tint="@color/white"
            android:layout_marginBottom="@dimen/vertical_margin"
            app:layout_constraintBottom_toTopOf="@id/actionsLayout"
            app:layout_constraintEnd_toStartOf="@id/dummy"
            app:srcCompat="@drawable/ic_action_camera"
            android:elevation="100dp"
            android:visibility="gone"/>

        <!-- Gallery FAB (opens photo gallery selection) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/chatSendFromGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            app:backgroundTint="@color/colorGreen"
            app:fabSize="auto"
            app:tint="@color/white"
            android:layout_marginBottom="@dimen/vertical_margin_smaller"
            app:layout_constraintBottom_toTopOf="@+id/chatSendFromCamera"
            app:layout_constraintEnd_toEndOf="@id/chatSendFromCamera"
            app:layout_constraintStart_toStartOf="@id/chatSendFromCamera"
            app:srcCompat="@drawable/ic_action_gallery"
            android:elevation="100dp"
            android:visibility="gone"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
