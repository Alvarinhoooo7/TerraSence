# ─────────────────────────────────────────────────────────────
# SECRETOS Y VARIABLES DE ENTORNO  —  NUNCA versionar
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Claves y certificados
*.pem
*.key
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
service-account*.json
*firebase-adminsdk*.json

# ─────────────────────────────────────────────────────────────
# NODE / JAVASCRIPT
# ─────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.eslintcache

# ─────────────────────────────────────────────────────────────
# EXPO / REACT NATIVE  (App/)
# ─────────────────────────────────────────────────────────────
.expo/
.expo-shared/
dist/
dist-review/
web-build/
*.jsbundle
android/
ios/
!App/android/app/proguard-rules.pro

# ─────────────────────────────────────────────────────────────
# VITE / CONSOLA WEB  (Web/)
# ─────────────────────────────────────────────────────────────
Web/dist/
Web/.vite/
*.local

# ─────────────────────────────────────────────────────────────
# VERCEL
# ─────────────────────────────────────────────────────────────
.vercel/

# ─────────────────────────────────────────────────────────────
# SUPABASE  (CLI local)
# ─────────────────────────────────────────────────────────────
supabase/.branches/
supabase/.temp/
supabase/.env

# Migraciones de un solo uso con datos sensibles en texto plano (p.ej. alta
# directa de un usuario por SQL). Se aplican con `supabase db push` igual que
# cualquier otra, pero nunca deben llegar al remoto de git. Convención:
# nombrarlas *.local.sql.
supabase/migrations/*.local.sql
supabase/migrations_archivo/*.local.sql

# ─────────────────────────────────────────────────────────────
# FIRMWARE ESP32  (PlatformIO / ESP-IDF)
# ─────────────────────────────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
Firmware/build/
Firmware/.build/
Firmware/sdkconfig.old
Firmware/managed_components/
*.bin
*.elf
*.map

# ─────────────────────────────────────────────────────────────
# KICAD  (PCB/)
# ─────────────────────────────────────────────────────────────
*-backups/
*.kicad_prl
*.kicad_pcb-bak
*.kicad_sch-bak
fp-info-cache
_autosave-*
\#auto_saved_files\#
~*.*

# ─────────────────────────────────────────────────────────────
# CAD / IMPRESIÓN 3D
# ─────────────────────────────────────────────────────────────
*.gcode
*.stl.bak

# ─────────────────────────────────────────────────────────────
# EDITORES Y SISTEMA OPERATIVO
# ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# ─────────────────────────────────────────────────────────────
# TEMPORALES Y COBERTURA
# ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.tmp
*.log
tmp/

# Espacios de trabajo temporales de los agentes: cachés, renders intermedios,
# perfiles de navegador de vista previa y scripts de un solo uso. Nada de esto
# es fuente: la marca vive en Logo/ y los recursos distribuibles los genera
# `npm run assets:brand`.
.tmp-*/
.tmp_*.py
.brand-preview/
.brand-preview-*.txt
.brand-browser-direct/

PCB/.history/
Referencias/
scratch/

# Cache de Python del modelo financiero
__pycache__/
*.py[cod]

# Coleccion de agent skills instalada fuera del repositorio
# (187 skills, ~94 MB de demos). Se reinstala desde skills-lock.json.
.agents/
skills-lock.json

# Presentaciones de clase de los ramos. Son material docente, no del proyecto,
# y pesan decenas de MB en un repositorio publico.
*.pptx
.vercel

# Herramientas locales de inspección de la interfaz (plugins inyectados por el editor)
.basalt/
