<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Palette for the Gmail-style app-icon monogram avatars (see glide/AppIconMonogram.kt).
        Every colour must keep enough contrast against white text. Order is irrelevant: the index
        is chosen deterministically from the app name hash, so adding/removing/reordering colours
        only reshuffles which app gets which colour. Tweak freely.
    -->
    <color name="monogram_red">#D32F2F</color>
    <color name="monogram_pink">#C2185B</color>
    <color name="monogram_purple">#7B1FA2</color>
    <color name="monogram_deep_purple">#512DA8</color>
    <color name="monogram_indigo">#303F9F</color>
    <color name="monogram_blue">#1976D2</color>
    <color name="monogram_light_blue">#0288D1</color>
    <color name="monogram_teal">#00796B</color>
    <color name="monogram_green">#388E3C</color>
    <color name="monogram_orange">#F57C00</color>
    <color name="monogram_deep_orange">#E64A19</color>
    <color name="monogram_blue_grey">#455A64</color>

    <array name="app_monogram_colors">
        <item>@color/monogram_red</item>
        <item>@color/monogram_pink</item>
        <item>@color/monogram_purple</item>
        <item>@color/monogram_deep_purple</item>
        <item>@color/monogram_indigo</item>
        <item>@color/monogram_blue</item>
        <item>@color/monogram_light_blue</item>
        <item>@color/monogram_teal</item>
        <item>@color/monogram_green</item>
        <item>@color/monogram_orange</item>
        <item>@color/monogram_deep_orange</item>
        <item>@color/monogram_blue_grey</item>
    </array>
</resources>
