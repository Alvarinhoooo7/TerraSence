<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="chipStyle">@style/ChipChoice</item>
        <item name="tabStyle">@style/AppTheme.TabLayout</item>
        <item name="materialCardViewStyle">@style/DefaultMaterialCardView</item>
    </style>

    <!-- Default MaterialCardView style -->
    <style name="DefaultMaterialCardView" parent="Widget.MaterialComponents.CardView">
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Theme.Transparent" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ToolbarTheme" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:itemTextAppearance">@style/menuItem</item>
    </style>

    <style name="MaterialAppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="EditTextThemeUser" parent="Widget.AppCompat.EditText">
        <item name="colorControlNormal">@color/colorPrimary</item>
        <item name="colorControlHighlight">@color/colorPrimary</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
    </style>

    <style name="menuItem" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextInputLayoutStyleUser" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimaryLighter</item>
        <item name="boxStrokeErrorColor">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/colorPrimaryTrans</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="suffixTextColor">@color/colorPrimary</item>
    </style>

    <style name="ChipChoice" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_background_1</item>
        <item name="android:textColor">@color/chip_text_white</item>
    </style>

    <style name="CollapsingToolbarExpanded" parent="ToolbarTheme">
        <item name="android:textColor">@android:color/transparent</item>
    </style>

    <style name="CollapsingToolbarCollapsed" parent="ToolbarTheme">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="splashScreenTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@drawable/splash_screen_background</item>
    </style>

    <!-- Android 12+ system splash (androidx.core:core-splashscreen). Shows the
         launcher icon centred on colorPrimary, then hands off to
         splashScreenTheme while DispatchActivity routes onward. -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorPrimary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/splashScreenTheme</item>
    </style>

    <style name="Widget.App.Button.OutlinedButton.IconOnly" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!--Tab Layout-->
    <style name="AppTheme.TabLayout" parent="Widget.Design.TabLayout">
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabBackground">?colorAccent</item>
        <item name="tabIndicatorColor">@color/white</item>
    </style>

    <!-- Dug Switch-->
    <style name="Dug.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="trackTint">@color/white</item>
        <item name="thumbTint">@color/dug_switch_color</item>
        <item name="switchMinWidth">60dp</item>
    </style>

    <style name="Dug.Switch.GrayTrack" parent="Dug.Switch">
        <item name="trackTint">@color/dug_gray_track_switch</item>
    </style>

    <!-- Profanity -->
    <style name="Dug.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">16dp</item>
        <item name="chipMinTouchTargetSize">0dp</item>
        <item name="android:checkable">false</item>
        <item name="android:clickable">false</item>
    </style>

    <!-- Dug Filter Chips — purple active, white inactive -->
    <style name="Dug.Chip.Filter" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/dug_chip_filter_bg</item>
        <item name="android:textColor">@color/dug_chip_filter_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipIconVisible">true</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipStrokeColor">@color/dug_chip_filter_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <!-- Dug Severity Chip — small pill for Low/Moderate/High -->
    <style name="Dug.Chip.Severity" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="chipMinHeight">24dp</item>
        <item name="chipMinTouchTargetSize">0dp</item>
        <item name="android:checkable">false</item>
        <item name="android:clickable">false</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="chipCornerRadius">12dp</item>
    </style>

    <!-- Dug Risk Factor / Category Chip — small colored pill -->
    <style name="Dug.Chip.Tag" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="chipMinHeight">24dp</item>
        <item name="chipMinTouchTargetSize">0dp</item>
        <item name="android:checkable">false</item>
        <item name="android:clickable">false</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="chipCornerRadius">12dp</item>
    </style>

    <!-- Dug Music Artwork — rounded corners -->
    <style name="ShapeAppearance.Dug.MusicArtwork" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dug_music_artwork_radius</item>
    </style>

    <!-- Dug Detail Section Title -->
    <style name="Dug.Detail.SectionTitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/dug_text_primary</item>
    </style>

    <!-- Dug Detail Body Text -->
    <style name="Dug.Detail.BodyText" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/dug_text_body</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- Dug Detail Chips — larger, readable, MD3-compliant -->
    <style name="Dug.Chip.Detail" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:checkable">false</item>
        <item name="android:clickable">false</item>
        <item name="chipIconSize">14dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
    </style>

    <!-- App Protection -->
    <style name="AppProtectionTitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">@dimen/app_protection_titles_size</item>
        <item name="android:textColor">@color/app_protection_dug_warning_titles</item>
    </style>

    <style name="AppProtectionContent" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/app_protection_dug_warning_content</item>
    </style>

    <!-- Action buttons for App Protection -->
    <style name="Widget.App.AppProtectionFAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="tint">@color/white</item>
        <item name="elevation">10dp</item>
        <item name="android:elevation">10dp</item>
    </style>

    <style name="Widget.App.AppProtectionAllowFAB" parent="Widget.App.AppProtectionFAB">
        <item name="backgroundTint">@color/app_protection_allow_color</item>
    </style>

    <style name="Widget.App.AppProtectionBlockFAB" parent="Widget.App.AppProtectionFAB">
        <item name="backgroundTint">@color/app_protection_block_color</item>
    </style>

    <!-- For rounded app images with Material ShapeableImageView -->
    <style name="safeAppImageView" >
        <item name="android:padding">2dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:elevation">2dp</item>
        <item name="shapeAppearanceOverlay">@style/circleImageView</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="AppProtectionItemIcon">
        <item name="android:padding">2dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="shapeAppearanceOverlay">@style/circleImageView</item>
        <item name="contentPadding">5dp</item>
    </style>

    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Buttons with rounded corners -->
    <style name="ShapeAppearance.App.RoundedButton" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ThemeOverlay.App.PlayStoreButton" parent="">
        <item name="colorPrimary">@color/app_protection_go_to_play_store_button</item>
