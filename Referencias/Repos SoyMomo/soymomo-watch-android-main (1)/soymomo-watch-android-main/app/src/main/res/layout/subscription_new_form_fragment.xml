<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/watch_settings_profile_background"
            app:collapsedTitleTextAppearance="@style/CollapsingToolbarCollapsed"
            app:contentScrim="@color/colorPrimary"
            app:expandedTitleTextAppearance="@style/CollapsingToolbarExpanded"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/SimStepCardHeader.Under"
                app:layout_collapseMode="parallax"
                app:layout_scrollFlags="scroll|enterAlwaysCollapsed">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/app_bar_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="?attr/actionBarSize" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/plan_card_background"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_percent=".6"
                    app:srcCompat="@drawable/ic_plan_background"
                    app:layout_constraintTop_toBottomOf="@+id/app_bar_guide"
                    app:layout_constraintBottom_toTopOf="@+id/subscription_form_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintDimensionRatio="w,160:234"/>

                <include
                    layout="@layout/item_sim_plan_small"
                    android:id="@+id/plan_info"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="24dp"
                    app:layout_constraintTop_toTopOf="@+id/plan_card_background"
                    app:layout_constraintBottom_toBottomOf="@+id/plan_card_background"
                    app:layout_constraintStart_toStartOf="@+id/plan_card_background"
                    app:layout_constraintEnd_toEndOf="@+id/plan_card_background" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/subscription_form_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin_large"
                    android:padding="@dimen/horizontal_margin"
                    android:background="@drawable/sim_card_form_background"
                    android:fontFamily="@font/robotomedium"
                    android:text="@string/subscription_form_title"
                    android:textAlignment="center"
                    android:textColor="@color/background_sim_step_card_title"
                    android:textSize="@dimen/add_watch_title_text_size"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/plan_card_background" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:theme="@style/ToolbarTheme"
                android:background="@color/background_sim_step_card_title"
                app:layout_collapseMode="pin"/>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:transitionGroup="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/horizontal_margin_large"
            android:background="@color/white"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Error Message -->
            <LinearLayout
                android:id="@+id/form_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/sim_card_form_error_background"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_error_form" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:textColor="@color/form_error_text"
                    android:text="@string/subscription_form_error_message"/>

            </LinearLayout>

            <!-- Account summary: same component as user_profile_card in settings_app_main_fragment.
                 Replaces the inputs when the account already answers every field. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin"
                android:visibility="gone"
                app:cardBackgroundColor="@color/background_sim_step_card_title"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@+id/form_error_message"
                tools:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/horizontal_margin">

                    <!-- Header row: what the card is, and the action on it -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/summary_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:fontFamily="@font/poppins"
                        android:text="@string/subscription_form_summary_title"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/button_edit"
                        app:layout_constraintEnd_toStartOf="@id/button_edit"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/button_edit" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_edit"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:insetTop="6dp"
                        android:insetBottom="6dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="@dimen/horizontal_margin"
                        android:text="@string/settings_app_edit"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/vertical_margin_smallest"
                        app:iconSize="14dp"
                        app:iconTint="@color/white"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:rippleColor="@color/white"
                        app:strokeColor="@color/white"
                        app:strokeWidth="1dp" />

                    <!-- Body: name, email and phone get the full card width -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/summary_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vertical_margin"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/button_edit"
                        tools:text="Thomas Pryce Jones" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/summary_email"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vertical_margin_smallest"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/summary_name"
                        tools:text="thomas191225@soymomo.com" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/summary_phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vertical_margin_smallest"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/summary_email"
                        tools:text="+56 989589426" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Personal Information -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_name"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@+id/summary_card">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/background_sim_step_card_title"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_last_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_last_name"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contact Information -->
            <com.hbb20.CountryCodePicker
                android:id="@+id/ccp"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                app:ccp_autoDetectCountry="true"
                app:ccp_autoDetectLanguage="true"
                app:ccp_contentColor="@color/background_sim_step_card_title"
                app:ccp_countryAutoDetectionPref="SIM_NETWORK_LOCALE"
                app:ccp_defaultLanguage="SPANISH"
                app:ccp_defaultNameCode="CL"
                app:ccp_showNameCode="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/til_user_phone"
                app:layout_constraintBottom_toBottomOf="@+id/til_user_phone"
                tools:text="+56"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_user_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/subscription_form_label_phone_number"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintStart_toEndOf="@+id/ccp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/til_last_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_email"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_user_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Address Information -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/address_label"
                style="@style/TextViewSubscriptionFormLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subscription_form_label_address"
                android:textSize="@dimen/add_watch_form_label"
                android:textColor="@color/background_sim_step_card_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/til_email" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_placeholder_address"
                style="@style/SimTextInputLayoutStyle"
                app:endIconDrawable="@drawable/ic_search"
                app:endIconMode="custom"
                app:endIconTint="@color/white"
                app:errorIconDrawable="@drawable/ic_search"
                app:errorIconTint="@color/white"
                app:layout_constraintTop_toBottomOf="@id/address_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress"
                    android:clickable="true"
                    android:focusable="false"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_optional_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/subscription_form_placeholder_optional_address"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_address">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_city"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_optional_address">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_state"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_city">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_postal_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_postal_code"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_state">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Terms and Privacy: accepted by continuing, links are spans set in code -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/terms_notice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin"
                android:fontFamily="@font/poppins"
                android:textColor="@color/grey_600"
                android:textSize="@dimen/add_watch_form_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/til_postal_code"
                tools:text="By continuing you accept SoyMomo's Terms and Conditions and Privacy Policy." />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_personal_fields"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="til_name,til_last_name,ccp,til_user_phone,til_email" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Action bar: pinned to the window like the other steps in this flow.
         Horizontal padding sits on the children so the hairline can run edge to edge. -->
    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingBottom="@dimen/vertical_margin_medium">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/vertical_margin_small"
            android:background="@color/greySeparator" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="@dimen/horizontal_margin_large">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_next"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/subscription_form_button_continue"
                style="@style/SimButton.Positive" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:elevation="16dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/colorPrimaryDark"
                app:indicatorColor="@color/white"
                app:trackColor="@color/colorPrimaryDark" />

        </FrameLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/cancel_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/horizontal_margin_large"
            android:layout_marginTop="@dimen/vertical_margin_small"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="@string/subscription_new_choose_plan_remember_can_cancel"
            android:textColor="@color/grey_600"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>