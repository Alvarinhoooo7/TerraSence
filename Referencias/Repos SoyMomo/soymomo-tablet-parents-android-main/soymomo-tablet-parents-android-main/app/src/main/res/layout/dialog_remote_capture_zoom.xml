<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:paddingLeft="@dimen/horizontal_margin"
    android:paddingTop="@dimen/vertical_margin"
    android:paddingRight="@dimen/horizontal_margin"
    android:paddingBottom="@dimen/vertical_margin">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/hidden_left_arrow"
            app:layout_constraintStart_toEndOf="@id/hidden_left_arrow"
            app:layout_constraintEnd_toStartOf="@id/hidden_right_arrow"
            android:background="@drawable/settings_card_dialog_white"
            >

                <ImageView
                    android:id="@+id/image_zoomed"
                    android:layout_width="300dp"
                    android:layout_height="500dp"
                    android:src="@drawable/app_protection_header_background"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/bottom"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bottom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@drawable/settings_card_dialog_primary"
                    android:padding="16dp">

                        <TextView
                            android:id="@+id/text_localisation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_remote_capture_location"
                            style="@style/ParentControlFeatureDescription"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toTopOf="@+id/text_date"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/text_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/settings_remote_capture_date"
                            style="@style/ParentControlFeatureDescription"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/right_arrow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/remote_capture_right_arrow"
            app:layout_constraintEnd_toEndOf="@id/card"
            app:layout_constraintTop_toBottomOf="@id/card"
            android:layout_marginTop="16dp"
            />

        <ImageView
            android:id="@+id/hidden_right_arrow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/remote_capture_right_arrow"
            app:layout_constraintEnd_toEndOf="@id/card"
            app:layout_constraintTop_toBottomOf="@+id/card"
            android:visibility="invisible"
            android:layout_marginTop="16dp"
            />

        <ImageView
            android:id="@+id/left_arrow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/remote_capture_left_arrow"
            app:layout_constraintStart_toStartOf="@+id/card"
            app:layout_constraintTop_toBottomOf="@id/card"
            android:layout_marginTop="16dp"
            />

        <ImageView
            android:id="@+id/hidden_left_arrow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/remote_capture_left_arrow"
            app:layout_constraintStart_toStartOf="@+id/card"
            app:layout_constraintTop_toBottomOf="@id/card"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="invisible"
            android:layout_marginVertical="16dp"
            />

</androidx.constraintlayout.widget.ConstraintLayout>