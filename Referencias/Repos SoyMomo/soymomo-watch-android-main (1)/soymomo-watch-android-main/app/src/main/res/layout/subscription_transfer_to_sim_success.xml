<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".sim.ui.fragments.transfer.SubscriptionTransferNewSimSuccessFragment">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_accept" >

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:collapsedTitleTextAppearance="@style/CollapsingToolbarCollapsed"
                app:contentScrim="@color/colorPrimary"
                app:expandedTitleTextAppearance="@style/CollapsingToolbarExpanded"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/header"
                    style="@style/SimStepCardHeader.Over"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="parallax"
                    app:layout_scrollFlags="scroll|enterAlwaysCollapsed">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/app_bar_guide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_begin="?attr/actionBarSize" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/header_image"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintHeight_percent=".5"
                        style="@style/SimStepCardImage"
                        app:srcCompat="@drawable/ic_sim_transfer_to_sim"
                        app:layout_constraintTop_toBottomOf="@id/app_bar_guide"
                        app:layout_constraintBottom_toTopOf="@+id/header_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/header_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
                        android:layout_marginVertical="@dimen/vertical_margin"
                        android:text="@string/subscription_transfer_to_new_sim_success_title"
                        style="@style/SimStepCardTitle"
                        app:layout_constraintTop_toBottomOf="@id/header_image"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_preinstalled_dialog"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
                        app:icon="@drawable/ic_sim"
                        style="@style/SimButton.Positive"
                        android:text="!"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/header_title"
                        app:layout_constraintTop_toTopOf="@+id/header_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:visibility="gone"
                        tools:enabled="true"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@color/background_sim_step_card_title"
                    android:theme="@style/ToolbarTheme"
                    app:layout_collapseMode="pin" />

            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:transitionGroup="true"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/enter_icc_id_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/horizontal_margin_large"
                    android:layout_marginTop="@dimen/vertical_margin_large"
                    android:text="@string/subscription_transfer_to_new_sim_success_description"
                    style="@style/SimStepCardContent"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="12sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/subscription_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/horizontal_margin_large"
                    android:layout_marginTop="@dimen/vertical_margin"
                    app:cardBackgroundColor="@color/white"
                    style="@style/SimContentCardView"
                    app:layout_constraintTop_toBottomOf="@id/enter_icc_id_description"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ViewFlipper
                        android:id="@+id/subscription_card_flipper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/subscription_card_activated_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" >

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/subscription_card_activated_image"
                                android:layout_width="@dimen/watch_card_profile_picture_size"
                                android:layout_height="@dimen/watch_card_profile_picture_size"
                                android:layout_marginStart="@dimen/horizontal_margin"
                                android:layout_marginVertical="@dimen/vertical_margin"
                                style="@style/contactImageView.noBorder"
                                app:srcCompat="@drawable/ic_soymomo_sim"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/action_copy_content_clipboard"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_margin="@dimen/vertical_margin"
                                android:src="@drawable/ic_action_content_copy"
                                android:tint="@color/colorPrimary"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/subscription_card_activated_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/subscription_payment_success_card_activated_title"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary"
                                style="@style/SimContentCardViewContent"
                                app:layout_constraintTop_toTopOf="@id/subscription_card_activated_image"
                                app:layout_constraintStart_toEndOf="@+id/subscription_card_activated_image"
                                app:layout_constraintEnd_toEndOf="parent"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/subscription_card_activated_phone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                style="@style/SimContentCardViewContent"
                                android:textColor="@color/colorPrimary"
                                app:layout_constraintTop_toBottomOf="@+id/subscription_card_activated_title"
                                app:layout_constraintStart_toEndOf="@+id/subscription_card_activated_image"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="@id/subscription_card_activated_image"
                                tools:text="+56989589426"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/subscription_card_finish_later_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" >

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/subscription_card_finish_later_image"
                                android:layout_width="@dimen/watch_card_profile_picture_size"
                                android:layout_height="@dimen/watch_card_profile_picture_size"
                                android:layout_marginStart="@dimen/horizontal_margin"
                                android:layout_marginVertical="@dimen/vertical_margin"
                                style="@style/contactImageView.noBorder"
                                app:srcCompat="@drawable/ic_soymomo_sim"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/subscription_card_finish_later_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/subscription_payment_success_card_finish_later_title"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary"
                                style="@style/SimContentCardViewContent"
                                app:layout_constraintTop_toTopOf="@id/subscription_card_finish_later_image"
                                app:layout_constraintStart_toEndOf="@+id/subscription_card_finish_later_image"
                                app:layout_constraintEnd_toEndOf="parent"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/subscription_card_finish_later_description"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                style="@style/SimContentCardViewContent"
                                android:textColor="@color/colorPrimary"
                                android:text="@string/subscription_payment_success_card_finish_later_description"
                                app:layout_constraintTop_toBottomOf="@+id/subscription_card_finish_later_title"
                                app:layout_constraintStart_toEndOf="@+id/subscription_card_finish_later_image"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="@id/subscription_card_finish_later_image" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </ViewFlipper>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_accept"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:text="@string/button_subscriptions"
        style="@style/SimButton.Positive"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1.0"
        tools:enabled="true"/>

</androidx.constraintlayout.widget.ConstraintLayout>