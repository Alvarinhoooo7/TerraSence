<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_request_sim_header"
                android:paddingStart="@dimen/horizontal_margin"
                android:paddingEnd="@dimen/horizontal_margin"
                android:paddingTop="@dimen/vertical_margin"
                android:paddingBottom="@dimen/vertical_margin">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/request_sim_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/button_cancel"
                    app:srcCompat="@drawable/ic_close"
                    app:tint="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/request_sim_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/request_sim_popup_title"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/request_sim_close" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/request_sim_image"
                    android:layout_width="340dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="@dimen/vertical_margin_small"
                    app:srcCompat="@drawable/request_sim_header_"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/request_sim_title" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/request_sim_company_image"
                    android:layout_width="140dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/vertical_margin_small"
                    app:srcCompat="@drawable/entel_sim_sub"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/request_sim_image" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/horizontal_margin"
                android:paddingEnd="@dimen/horizontal_margin"
                android:paddingTop="@dimen/vertical_margin"
                android:paddingBottom="@dimen/vertical_margin">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/request_sim_discount_percent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:textAlignment="center"
                    android:textColor="@color/background_onboarding"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    tools:text="35% OFF" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/request_sim_discount_months"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:textAlignment="center"
                    android:textColor="@color/background_onboarding"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="for 2 months" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/vertical_margin_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/vertical_margin_smallest">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/horizontal_margin_small"
                            android:padding="6dp"
                            android:background="@drawable/bg_request_sim_bullet_icon"
                            app:srcCompat="@drawable/high_signal"
                            app:tint="@android:color/white" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/request_sim_bullet_coverage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins"
                            tools:text="Better coverage and better signal" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/vertical_margin_smallest">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/horizontal_margin_small"
                            android:padding="6dp"
                            android:background="@drawable/bg_request_sim_bullet_icon"
                            app:srcCompat="@drawable/ic_location_24"
                            app:tint="@android:color/white" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/request_sim_bullet_location"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins"
                            tools:text="Better GPS precision" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/horizontal_margin_small"
                            android:padding="6dp"
                            android:background="@drawable/bg_request_sim_bullet_icon"
                            app:srcCompat="@drawable/ic_watch_setting_battery"
                            app:tint="@android:color/white" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/request_sim_bullet_battery"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins"
                            tools:text="Longer battery life" />
                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/request_sim_plans_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/request_sim_plans_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin_small"
                    android:paddingTop="12dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_request_sim_plan"
                    tools:itemCount="3" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/request_sim_bottom_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:fontFamily="@font/poppins"
                    android:text="@string/request_sim_popup_bottom_text"
                    android:textAlignment="center"
                    android:textColor="@color/background_sim_step_card_title"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/request_sim_cta_button"
                    style="@style/SimButton.Positive"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/first_momo_button_height"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:text="@string/request_sim_popup_button_label"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:backgroundTint="@color/background_sim_step_card_title"
                    android:textColor="@android:color/white" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
