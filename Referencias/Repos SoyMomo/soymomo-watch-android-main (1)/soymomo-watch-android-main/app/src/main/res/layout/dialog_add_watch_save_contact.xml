<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_add_watch_save_contact_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/horizontal_margin"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/horizontal_margin"
    android:paddingBottom="@dimen/vertical_margin">

    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:background="@drawable/bottom_sheet_drag_handle" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/save_contact_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/background_onboarding"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:text="Save Rai's watch number?" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/save_contact_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vertical_margin_small"
        android:fontFamily="@font/poppins"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/black_70"
        android:textSize="15sp"
        tools:text="Save this number so you can call Rai's watch and recognize incoming calls. You'll review it before saving." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save_contact_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/first_momo_button_height"
        android:layout_marginTop="@dimen/vertical_margin"
        android:backgroundTint="@color/button_onboarding_enabled"
        android:fontFamily="@font/poppins"
        android:text="@string/add_watch_save_kid_contact_save"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/add_watch_button_text_size"
        android:textStyle="bold"
        app:cornerRadius="@dimen/first_momo_button_border" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/skip_contact_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/first_momo_button_height"
        android:layout_marginTop="@dimen/vertical_margin_smallest"
        android:fontFamily="@font/poppins"
        android:text="@string/add_watch_save_kid_contact_skip"
        android:textAllCaps="false"
        android:textColor="@color/background_onboarding"
        android:textSize="@dimen/add_watch_button_text_size"
        android:textStyle="bold" />

</LinearLayout>
