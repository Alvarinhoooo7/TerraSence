<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/corner_radius_item_detection"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/grey_400">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vertical_margin"
        android:paddingTop="@dimen/vertical_margin_small"
        android:paddingEnd="@dimen/vertical_margin_small"
        android:paddingBottom="@dimen/vertical_margin_small">

        <ImageView
            android:id="@+id/detection_icon"
            android:layout_width="@dimen/mood_detection_app_icon_size"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_dug_smart_detection" />

        <TextView
            android:id="@+id/detection_title"
            style="@style/ParentControlAppCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            app:layout_constraintBottom_toTopOf="@+id/detection_description"
            app:layout_constraintStart_toEndOf="@+id/detection_icon"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="TextNoTranslation"
            tools:text="@string/dug_detection_chrome_app" />

        <TextView
            android:id="@+id/detection_description"
            style="@style/ParentControlAppCardDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/detection_date"
            app:layout_constraintEnd_toStartOf="@+id/detection_chip_group"
            app:layout_constraintStart_toEndOf="@+id/detection_icon"
            app:layout_constraintTop_toBottomOf="@+id/detection_title"
            tools:ignore="TextNoTranslation"
            tools:text="@string/dug_detection_hate_message" />

        <TextView
            android:id="@+id/detection_date"
            style="@style/ParentControlAppCardDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/detection_chip_group"
            app:layout_constraintStart_toEndOf="@+id/detection_icon"
            app:layout_constraintTop_toBottomOf="@+id/detection_description"
            tools:ignore="TextNoTranslation"
            tools:text="@string/dug_detection_detected_date" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/detection_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:chipSpacingHorizontal="10000dp"
            app:chipSpacingVertical="4dp"
            android:scaleX="-1">

            <com.google.android.material.chip.Chip
                android:id="@+id/detection_chip"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                tools:text="¡Grave!"
                app:chipBackgroundColor="@color/colorChipSerious"
                android:textSize="8sp"
                android:textColor="@color/white"
                app:chipMinTouchTargetSize="0dp"
                android:scaleX="-1"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/grooming_chip"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:text="@string/grooming"
                app:chipBackgroundColor="@color/colorChipGrooming"
                android:textSize="6sp"
                android:textColor="@color/white"
                app:chipMinTouchTargetSize="0dp"
                android:scaleX="-1"
                android:visibility="gone"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/cyberbullying_chip"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:text="@string/cyberbullying"
                app:chipBackgroundColor="@color/colorChipCyberbullying"
                android:textSize="6sp"
                android:textColor="@color/white"
                app:chipMinTouchTargetSize="0dp"
                android:scaleX="-1"
                android:visibility="gone"
                />

        </com.google.android.material.chip.ChipGroup>


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
