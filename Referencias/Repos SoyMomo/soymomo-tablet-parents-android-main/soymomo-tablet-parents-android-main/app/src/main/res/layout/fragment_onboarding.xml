<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:clipToPadding="false"
    tools:context=".onboarding.ui.OnboardingFragment">

    <!-- Lottie animation for visual content -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/tutorial_lottie_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
        android:layout_marginTop="@dimen/vertical_margin_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/lottie_loading"
        tools:src="@tools:sample/avatars" />

    <!-- Title stays pinned below the Lottie. -->
    <TextView
        android:id="@+id/tutorial_title"
        style="@style/OnboardingTitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:textAlignment="textStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tutorial_lottie_view"
        tools:text="Welcome to SoyMomo" />

    <!-- Description text scrolls if it can't fit between the title and the finish
         button on short screens (e.g. 720x1280 / sw360dp). -->
    <ScrollView
        android:id="@+id/tutorial_text_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/button_tutorial_finish"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tutorial_title">

        <TextView
            android:id="@+id/tutorial_text"
            style="@style/OnboardingDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:lineSpacingExtra="4dp"
            android:textAlignment="textStart"
            tools:text="This is a description of the onboarding page content." />

    </ScrollView>

    <!-- Finish button (visible only on last page) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_tutorial_finish"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="48dp"
        android:backgroundTint="@color/colorSecondary"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/button_tutorial_finish"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>