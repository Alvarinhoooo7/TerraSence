<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="@color/white">

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wearer_card_layout"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Background Layout -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/card_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vertical_margin_larger"
            android:background="@drawable/round_main_card_background"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Authorized Data -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/authorized_data"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/button_row"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="invisible" >

            <!-- Profile Layout -->
            <LinearLayout
                android:id="@+id/profile_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_xx_large"
                android:orientation="horizontal"
                app:layout_constraintEnd_toStartOf="@+id/authorized_watch_model_image"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/watch_profile_picture"
                    style="@style/contactImageView"
                    android:layout_width="@dimen/watch_card_profile_picture_size"
                    android:layout_height="@dimen/watch_card_profile_picture_size"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@drawable/momo_picture_default" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/horizontal_margin_small"
                    android:layout_marginTop="@dimen/vertical_margin_small"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/watch_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Javier Smith" />

                    <TextView
                        android:id="@+id/watch_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vertical_margin_smallest"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        tools:text="+56965463456" />

                    <!-- The disconnected_icon that used to sit here is gone. It was a mute
                         15x6dp unplugged-plug pictogram in a 32x20dp box, carrying no label
                         and a contentDescription of "@string/none" (literally the word
                         "None" to TalkBack). The banner above this card now states the same
                         thing in words, with the cause, how long, and the last battery
                         reading — and this card still shows the state three other ways: the
                         error background, the watch render's cause glyph, and the dimmed
                         action row. -->

                </LinearLayout>

            </LinearLayout>

            <!-- Watch Image -->
            <ImageView
                android:id="@+id/authorized_watch_model_image"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/horizontal_margin"
                android:layout_marginBottom="@dimen/vertical_margin_small"
                android:adjustViewBounds="true"
                android:contentDescription="@string/none"
                android:elevation="4dp"
                android:src="@drawable/watch_space3_0blue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Shine Effect -->
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/none"
                app:srcCompat="@drawable/momo_card_shine"
                app:layout_constraintBottom_toBottomOf="@id/authorized_watch_model_image"
                app:layout_constraintEnd_toEndOf="@id/authorized_watch_model_image"
                app:layout_constraintStart_toStartOf="@id/authorized_watch_model_image"
                app:layout_constraintTop_toTopOf="@id/authorized_watch_model_image" />

            <!-- Watch status image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/watch_status_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/no_sim"
                android:elevation="4dp"
                android:contentDescription="@string/none"
                app:layout_constraintBottom_toBottomOf="@id/authorized_watch_model_image"
                app:layout_constraintEnd_toEndOf="@id/authorized_watch_model_image"
                app:layout_constraintStart_toStartOf="@id/authorized_watch_model_image"
                app:layout_constraintTop_toTopOf="@id/authorized_watch_model_image"
                tools:visibility="invisible" />

            <!-- Battery Layout -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/battery_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:elevation="@dimen/vertical_margin_smallest"
                app:layout_constraintTop_toTopOf="@id/authorized_watch_model_image"
                app:layout_constraintBottom_toBottomOf="@id/authorized_watch_model_image"
                app:layout_constraintEnd_toEndOf="@id/authorized_watch_model_image"
                app:layout_constraintStart_toStartOf="@id/authorized_watch_model_image"
                tools:visibility="visible" >

                <LinearLayout
                    android:id="@+id/battery_info_linear_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/battery_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/battery_save"
                        android:contentDescription="@string/none" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/battery_percentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-2dp"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:fontFamily="@font/robotomedium"
                        tools:text="100%" />

                </LinearLayout>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/battery_percentage_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:trackColor="@color/transparent"
                    app:indicatorColor="@color/colorGreen"
                    app:indicatorTrackGapSize="2dp"
                    app:trackCornerRadius="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:progress="80"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Battery Alert -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/battery_alert_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="4dp"
                app:layout_constraintBottom_toBottomOf="@id/authorized_watch_model_image"
                app:layout_constraintEnd_toEndOf="@id/authorized_watch_model_image"
                app:layout_constraintStart_toStartOf="@id/authorized_watch_model_image"
                app:layout_constraintTop_toTopOf="@id/authorized_watch_model_image"
                tools:visibility="invisible" >

                <!-- Battery Alert Message -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/battery_alert_message_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:visibility="visible" >

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/battery_alert_dialog_card"
                        android:layout_width="112dp"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/white"
                        app:contentPadding="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/battery_alert_message_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/none"
                            android:textColor="@color/momoFont"
                            android:textAlignment="center"
                            android:textSize="9sp"
                            android:fontFamily="@font/robotomedium" />

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Unauthorized Data -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/unauthorized_data"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/button_row"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" >

            <!-- Profile Layout -->
            <LinearLayout
                android:id="@+id/unauthorized_profile_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_xx_large"
                android:orientation="horizontal"
                app:layout_constraintEnd_toStartOf="@+id/unauthorized_watch_model_image"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/unauthorized_watch_profile_picture"
                    style="@style/contactImageView"
                    android:layout_width="@dimen/watch_card_profile_picture_size"
                    android:layout_height="@dimen/watch_card_profile_picture_size"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@drawable/momo_picture_default" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/horizontal_margin_small"
                    android:layout_marginTop="@dimen/vertical_margin_small"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/unauthorized_watch_imei"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="8609093412384" />

                    <TextView
                        android:id="@+id/unauthorized_watch_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vertical_margin_smallest"
                        android:layout_marginEnd="@dimen/vertical_margin_smaller"
                        android:text="@string/unauthorized_watch_message"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Unauthorized watch Image -->
            <ImageView
                android:id="@+id/unauthorized_watch_model_image"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/horizontal_margin"
                android:layout_marginBottom="@dimen/vertical_margin_small"
                android:adjustViewBounds="true"
                android:contentDescription="@string/none"
                android:elevation="4dp"
                android:src="@drawable/watch_unauthorized"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- First interaction Data -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/first_interaction_data"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/button_row"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="invisible" >

            <!-- First Interaction Layout -->
            <LinearLayout
                android:id="@+id/first_interaction_profile_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_xx_large"
                android:orientation="horizontal"
                app:layout_constraintEnd_toStartOf="@+id/first_interaction_watch_model_image"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" >

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/first_interaction_watch_profile_picture"
                    style="@style/contactImageView"
                    android:layout_width="@dimen/watch_card_profile_picture_size"
                    android:layout_height="@dimen/watch_card_profile_picture_size"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@drawable/momo_picture_default" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/horizontal_margin_small"
                    android:layout_marginTop="@dimen/vertical_margin_small"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/first_interaction_watch_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Javier Smith" />

                    <TextView
                        android:id="@+id/first_interaction_watch_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vertical_margin_smallest"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:text="@string/watch_waiting_first_interaction" />

                    <!-- No icon here. This row already carries its own sentence
                         ("Awaiting first network connection…"), and the glyph that used to
                         sit here was the unplugged-plug one — which says "was connected,
                         then dropped", the opposite of a watch that has never checked in.
                         It was bound nowhere, so it showed unconditionally. -->

                </LinearLayout>

            </LinearLayout>

            <!-- Watch Image -->
            <ImageView
                android:id="@+id/first_interaction_watch_model_image"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/horizontal_margin"
                android:layout_marginBottom="@dimen/vertical_margin_small"
                android:adjustViewBounds="true"
                android:contentDescription="@string/none"
                android:elevation="4dp"
                android:src="@drawable/watch_space3_0blue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Shine Effect -->
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/none"
                app:srcCompat="@drawable/momo_card_shine"
                app:layout_constraintBottom_toBottomOf="@id/first_interaction_watch_model_image"
                app:layout_constraintEnd_toEndOf="@id/first_interaction_watch_model_image"
                app:layout_constraintStart_toStartOf="@id/first_interaction_watch_model_image"
                app:layout_constraintTop_toTopOf="@id/first_interaction_watch_model_image" />

            <!-- Progress bar -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/first_interaction_progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/white"
                app:trackColor="@color/white_50"
                android:elevation="@dimen/vertical_margin"
                app:layout_constraintTop_toTopOf="@id/first_interaction_watch_model_image"
                app:layout_constraintStart_toStartOf="@id/first_interaction_watch_model_image"
                app:layout_constraintEnd_toEndOf="@id/first_interaction_watch_model_image"
                app:layout_constraintBottom_toBottomOf="@id/first_interaction_watch_model_image"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Action Buttons -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/button_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/vertical_margin_small"
            app:justifyContent="space_evenly"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/button_action_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/none"
                app:srcCompat="@drawable/main_bar_settings_active"
                style="@style/mainBarButtonActive" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/button_action_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/none"
                app:srcCompat="@drawable/main_bar_call_active"
                style="@style/mainBarButtonActive" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/button_action_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/none"
                app:srcCompat="@drawable/main_bar_message_active"
                style="@style/mainBarButtonActive" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/button_action_directions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/none"
                app:srcCompat="@drawable/main_bar_maps_active"
                style="@style/mainBarButtonActive" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/button_action_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/none"
                android:src="@drawable/main_bar_location_active"
                style="@style/mainBarButtonActive" />

        </com.google.android.flexbox.FlexboxLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>