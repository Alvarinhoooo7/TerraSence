<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".sim.ui.fragments.SubscriptionEmptyFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:collapsedTitleTextAppearance="@style/CollapsingToolbarCollapsed"
            app:contentScrim="@color/colorPrimary"
            app:expandedTitleTextAppearance="@style/CollapsingToolbarExpanded"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header"
                style="@style/SimStepCardHeader.Over"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax"
                app:layout_scrollFlags="scroll|enterAlwaysCollapsed">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/app_bar_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="?attr/actionBarSize" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/header_image"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintHeight_percent=".5"
                    style="@style/SimStepCardImage"
                    app:srcCompat="@drawable/ic_soymomo_sim_card"
                    app:layout_constraintTop_toBottomOf="@id/app_bar_guide"
                    app:layout_constraintBottom_toTopOf="@+id/header_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/horizontal_margin_large"
                    android:layout_marginVertical="@dimen/vertical_margin"
                    android:text="@string/add_device_button_soymomo_sim"
                    style="@style/SimStepCardTitle"
                    app:layout_constraintTop_toBottomOf="@id/header_image"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/background_sim_step_card_title"
                android:theme="@style/ToolbarTheme"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:transitionGroup="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/horizontal_margin"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/white">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/subscribe_card_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginVertical="@dimen/vertical_margin_large"
                android:paddingHorizontal="@dimen/horizontal_margin"
                android:paddingBottom="@dimen/vertical_margin"
                android:background="@drawable/sim_card_subscribe_background"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="h,321:213">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/subscribe_image"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:srcCompat="@drawable/ic_sim_subscribe_plans"
                    app:layout_constraintDimensionRatio="h,28:17"
                    app:layout_constraintTop_toTopOf="parent"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_subscribe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/SimContentCardView"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/horizontal_margin_small">


                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/subscribe_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/subscription_empty_soymomo_sim_subscribe"
                            style="@style/SimContentCardTargetViewTitle"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/subscribe_icon" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/subscribe_icon"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@color/sim_button_positive"
                            app:contentPadding="@dimen/horizontal_margin_small"
                            app:srcCompat="@drawable/ic_arrow_go"
                            app:tint="@color/white"
                            app:shapeAppearanceOverlay="@style/circleImageView"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintWidth_percent=".1"
                            app:layout_constraintDimensionRatio="1"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/request_sim_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/vertical_margin"
                style="@style/SimContentCardView"
                app:layout_constraintTop_toBottomOf="@+id/subscribe_card_container">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/request_sim_card_image"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:srcCompat="@drawable/ic_sim_request_physical"
                        android:layout_margin="@dimen/vertical_margin_small"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintDimensionRatio="1:1"/>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/request_sim_card_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/ic_arrow_go"
                        android:layout_margin="@dimen/vertical_margin"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/request_sim_card_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/subscription_new_link_request_new_physical_sim"
                        android:textStyle="bold"
                        style="@style/SimContentCardViewContent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/request_sim_card_image"
                        app:layout_constraintEnd_toStartOf="@+id/request_sim_card_arrow"
                        app:layout_constraintBottom_toTopOf="@+id/request_sim_card_subtitle"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/request_sim_card_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/subscription_new_link_ask_new_sim_home"
                        style="@style/SimContentCardViewContent"
                        app:layout_constraintTop_toBottomOf="@+id/request_sim_card_title"
                        app:layout_constraintStart_toEndOf="@+id/request_sim_card_image"
                        app:layout_constraintEnd_toStartOf="@+id/request_sim_card_arrow"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/vertical_margin_larger"
                app:layout_constraintWidth_percent=".25"
                app:layout_constraintDimensionRatio="1"
                app:srcCompat="@drawable/subscription_sim_empty"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/request_sim_card"
                app:layout_constraintBottom_toTopOf="@id/footer_title"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/footer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/subscription_empty_what_is_soymomo_sim"
                android:textColor="@color/background_sim_step_card_title"
                android:textAlignment="center"
                style="@style/SimContentCardTargetViewTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/footer_subtitle" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/footer_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:fontFamily="@font/poppins"
                android:text="@string/subscription_empty_soymomo_sim_explanation"
                android:textAlignment="center"
                style="@style/SimContentCardViewContent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintVertical_bias="0.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>