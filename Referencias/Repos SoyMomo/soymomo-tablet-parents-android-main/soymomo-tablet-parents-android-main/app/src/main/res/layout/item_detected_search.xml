<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ly_item_detected_search_base"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:padding="8dp">

    <ImageView
        android:id="@+id/iv_item_detected_search_app_logo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:srcCompat="@drawable/instagram_logo" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_detection_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dug_unsafe_search_card_icon_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_item_detected_search_app_logo"
        app:chipBackgroundColor="@color/dug_unsafe_search_viral"
        style="@style/Dug.Chip"
        tools:text="Virales"/>

    <TextView
        android:id="@+id/tv_item_detected_search_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dug_unsafe_search_card_icon_margin"
        android:layout_marginEnd="4dp"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/chip_detection_category"
        app:layout_constraintBottom_toTopOf="@+id/tv_item_detected_search_date"
        app:layout_constraintStart_toEndOf="@+id/iv_item_detected_search_app_logo"
        app:layout_constraintEnd_toStartOf="@id/info_icon"
        tools:text="Instagram: Viral muy malo"/>

    <TextView
        android:id="@+id/tv_item_detected_search_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dug_unsafe_search_card_icon_margin"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_detected_search_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_item_detected_search_app_logo"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Búsqueda detectada 01/01/2021 12:34"/>

    <ImageView
        android:id="@+id/info_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:srcCompat="@drawable/ic_unsafe_search_info"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintHeight_percent=".45"
        app:layout_constraintDimensionRatio="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>