<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_space_app"
    tools:context=".videocall.ui.fragments.RingingIncomingFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/logo"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginHorizontal="@dimen/horizontal_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4"
            app:srcCompat="@drawable/logo_no_padding" />

        <TextView
            android:id="@+id/videocall_incoming_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/horizontal_margin_large"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/videocall_incoming"
            android:textAlignment="textStart"
            android:textColor="@color/white"
            android:textSize="32sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:layout_constraintWidth_percent="0.5" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/contact_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/horizontal_margin_jumbo"
            style="@style/contactImageView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.45"
            tools:srcCompat="@drawable/ic_momo" />

        <TextView
            android:id="@+id/contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contact_image"
            tools:text="SoyMomo"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/declineButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/first_momo_button_height"
            android:layout_marginHorizontal="@dimen/horizontal_margin_large"
            android:layout_marginVertical="@dimen/vertical_margin"
            android:backgroundTint="@color/colorAccent"
            android:elevation="@dimen/card_elevation"
            android:fontFamily="@font/poppins"
            android:text="@string/button_decline"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="@dimen/first_momo_button_border"
            app:icon="@drawable/ic_vector_hang_videocall"
            app:iconTint="@color/white"
            app:iconSize="32dp"
            app:iconPadding="@dimen/horizontal_margin"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/first_momo_button_height"
            android:layout_marginHorizontal="@dimen/horizontal_margin_large"
            android:layout_marginVertical="@dimen/vertical_margin"
            android:backgroundTint="@color/videocallGreen"
            android:elevation="@dimen/card_elevation"
            android:fontFamily="@font/poppins"
            android:text="@string/button_answer"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="@dimen/first_momo_button_border"
            app:icon="@drawable/ic_vector_accept_videocall"
            app:iconTint="@color/white"
            app:iconSize="32dp"
            app:iconPadding="@dimen/horizontal_margin"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>