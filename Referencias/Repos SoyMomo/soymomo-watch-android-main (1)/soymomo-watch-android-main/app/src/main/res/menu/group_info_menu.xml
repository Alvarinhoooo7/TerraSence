<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Visibility is flipped at runtime in GroupMembersFragment based on role:
         - edit / delete: admin-only
         - leave: any non-wearer active member (i.e. all parents) -->
    <item
        android:id="@+id/action_edit_group"
        android:title="@string/button_edit"
        app:showAsAction="ifRoom" />
    <item
        android:id="@+id/action_leave_group"
        android:title="@string/action_leave_group"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_delete_group"
        android:title="@string/action_delete_group"
        app:showAsAction="never" />
</menu>
