<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_subscriptions"
    app:startDestination="@id/subscriptionDispatchFragment">

    <fragment
        android:id="@+id/subscriptionDispatchFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.SubscriptionDispatchFragment"
        android:label="subscription_dispatch_fragment"
        tools:layout="@layout/subscription_dispatch_fragment" >
        <action
            android:id="@+id/action_subscriptionDispatchFragment_to_subscriptionEmptyFragment"
            app:destination="@id/subscriptionEmptyFragment" />
        <action
            android:id="@+id/action_subscriptionDispatchFragment_to_subscriptionListFragment"
            app:destination="@id/subscriptionListFragment" />
        <action
            android:id="@+id/action_subscriptionDispatchFragment_to_subscriptionDetailFragment"
            app:destination="@id/subscriptionDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/subscriptionEmptyFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.SubscriptionEmptyFragment"
        android:label="subscription_empty_fragment"
        tools:layout="@layout/subscription_empty_fragment" >
        <action
            android:id="@+id/action_subscriptionEmptyFragment_to_subscriptionUnavailableFragment"
            app:destination="@id/subscriptionUnavailableFragment" />
        <action
            android:id="@+id/action_subscriptionEmptyFragment_to_newSubscriptionChooseWearerFragment"
            app:destination="@id/newSubscriptionChooseWearerFragment" />
    </fragment>

    <fragment
        android:id="@+id/subscriptionListFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.SubscriptionListFragment"
        android:label="subscription_list_fragment"
        tools:layout="@layout/subscription_list_fragment" >
        <action
            android:id="@+id/action_subscriptionListFragment_to_subscriptionDetailFragment"
            app:destination="@id/subscriptionDetailFragment" />
        <action
            android:id="@+id/action_subscriptionListFragment_to_newSubscriptionChooseWearerFragment"
            app:destination="@id/newSubscriptionChooseWearerFragment" />
        <action
            android:id="@+id/action_subscriptionListFragment_to_subscriptionRestoreFragment"
            app:destination="@id/subscriptionRestoreFragment" />
        <action
            android:id="@+id/action_subscriptionListFragment_to_subscriptionUnavailableFragment"
            app:destination="@id/subscriptionUnavailableFragment" />
    </fragment>

    <fragment
        android:id="@+id/subscriptionUnavailableFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.SubscriptionUnavailableFragment"
        android:label="subscription_unavailable_fragment"
        tools:layout="@layout/subscription_unavailable_fragment" />

    <fragment
        android:id="@+id/subscriptionDetailFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.SubscriptionDetailFragment"
        android:label="subscription_detail_fragment"
        tools:layout="@layout/subscription_detail_fragment" >
        <action
            android:id="@+id/action_subscriptionDetailFragment_to_subscriptionRestoreFragment"
            app:destination="@id/subscriptionRestoreFragment" />
        <action
            android:id="@+id/action_subscriptionDetailFragment_to_subscriptionDetailTransferListFragment"
            app:destination="@id/subscriptionDetailTransferListFragment" />
        <action
            android:id="@+id/action_subscriptionDetailFragment_to_planUpgradeFragment"
            app:destination="@id/planUpgradeFragment" />
    </fragment>

    <fragment
        android:id="@+id/planUpgradeFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.PlanUpgradeFragment"
        android:label="plan_upgrade_fragment"
        tools:layout="@layout/fragment_plan_upgrade" />

    <fragment
        android:id="@+id/newSubscriptionChooseWearerFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.newsubscription.NewSubscriptionChooseWearerFragment"
        android:label="subscription_new_choose_wearer_fragment"
        tools:layout="@layout/subscription_new_choose_wearer_fragment" >
        <action
            android:id="@+id/action_newSubscriptionChooseWearerFragment_to_nav_add_sim"
            app:destination="@id/nav_add_sim" />
    </fragment>

    <fragment
        android:id="@+id/subscriptionRestoreFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.SubscriptionRestoreFragment"
        android:label="subscription_restore_fragment"
        tools:layout="@layout/subscription_restore_fragment" >
        <action
            android:id="@+id/action_subscriptionRestoreFragment_to_nav_add_sim"
            app:destination="@id/nav_add_sim" />
    </fragment>

    <include app:graph="@navigation/nav_add_sim" />
    <fragment
        android:id="@+id/subscriptionDetailTransferListFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.transfer.SubscriptionTransferListFragment"
        android:label="subscription_detail_transfer_list"
        tools:layout="@layout/subscription_transfer_list" >
        <action
            android:id="@+id/action_subscriptionDetailTransferListFragment_to_subscriptionTransferNewSimFragment"
            app:destination="@id/subscriptionTransferNewSimFragment" />
    </fragment>
    <fragment
        android:id="@+id/subscriptionTransferNewSimFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.transfer.SubscriptionTransferNewSimFragment"
        android:label="subscription_detail_transfer_to_sim"
        tools:layout="@layout/subscription_transfer_to_sim" >
        <action
            android:id="@+id/action_subscriptionTransferNewSimFragment_to_subscriptionTransferNewSimSuccessFragment"
            app:destination="@id/subscriptionTransferNewSimSuccessFragment" />
    </fragment>
    <fragment
        android:id="@+id/subscriptionTransferNewSimSuccessFragment"
        android:name="com.sosmartlabs.momo.sim.ui.fragments.transfer.SubscriptionTransferNewSimSuccessFragment"
        android:label="subscription_detail_transfer_to_sim_success"
        tools:layout="@layout/subscription_transfer_to_sim_success" />

</navigation>