<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="npsdialog"
            type="com.sosmartlabs.momo.nps.inapp.NPSDialog" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nps_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="48dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/nps_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="56dp"
                    app:cardBackgroundColor="@color/momo_background"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="12dp"
                    app:contentPaddingBottom="20dp"
                    app:contentPaddingLeft="20dp"
                    app:contentPaddingRight="20dp"
                    app:contentPaddingTop="64dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nps_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/nps_title"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.sosmartlabs.momo.nps.ExpandableHeightGridView
                            android:id="@+id/grid_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:numColumns="5"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="8dp" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:alpha="0.7"
                                android:text="@string/nps_not_likely"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:alpha="0.7"
                                android:gravity="end"
                                android:text="@string/nps_very_likely"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:contentPadding="12dp"
                            app:strokeColor="@color/nps_comment_border"
                            app:strokeWidth="1dp">

                            <EditText
                                android:id="@+id/user_comment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:gravity="top|start"
                                android:hint="@string/nps_comment"
                                android:importantForAutofill="no"
                                android:inputType="textMultiLine|textCapSentences"
                                android:lines="3"
                                android:text="@={npsdialog.userComment}"
                                android:textColor="@color/momoFont"
                                android:textColorHint="@color/momo_text_hint"
                                android:textSize="14sp"
                                tools:ignore="LabelFor" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/submit"
                            style="@style/CyanButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:enabled="false"
                            android:text="@string/nps_send"
                            android:textAllCaps="false"
                            android:textColor="@color/nps_submit_text_tint"
                            app:backgroundTint="@color/nps_submit_bg_tint" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:id="@+id/nps_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|top"
                    android:elevation="24dp"
                    android:importantForAccessibility="no"
                    android:outlineAmbientShadowColor="@color/nps_shadow"
                    android:outlineSpotShadowColor="@color/nps_shadow"
                    android:src="@drawable/nps_watch"
                    tools:targetApi="p" />

                <ImageView
                    android:id="@+id/close_nps"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="60dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nps_close"
                    android:elevation="16dp"
                    android:padding="10dp"
                    android:src="@drawable/nps_close"
                    android:tint="#B3FFFFFF"
                    tools:ignore="UseAppTint" />
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
