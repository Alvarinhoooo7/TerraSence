<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black">

    <com.canhub.cropper.CropImageView
        xmlns:custom="http://schemas.android.com/apk/res-auto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_rotate"
        android:id="@+id/crop_view"
        custom:cropFixAspectRatio="true"
        custom:cropAspectRatioX="1"
        custom:cropAspectRatioY="1"/>

    <Button
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textColor="@android:color/white"
        android:text="@string/button_cancel"
        android:layout_marginBottom="@dimen/vertical_margin_medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/button_rotate"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@android:color/transparent"
        android:id="@+id/button_cancel"/>

    <ImageButton
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/vertical_margin_medium"
        app:layout_constraintLeft_toRightOf="@id/button_cancel"
        app:layout_constraintRight_toLeftOf="@id/button_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/crop_view"
        android:background="@android:color/transparent"
        android:id="@+id/button_rotate"
        android:src="@drawable/ic_rotate_90_degrees_ccw_white_24dp"/>

    <Button
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textColor="@android:color/white"
        android:text="@string/button_save"
        android:layout_marginBottom="@dimen/vertical_margin_medium"
        app:layout_constraintLeft_toRightOf="@id/button_rotate"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@android:color/transparent"
        android:id="@+id/button_save"/>

</androidx.constraintlayout.widget.ConstraintLayout>