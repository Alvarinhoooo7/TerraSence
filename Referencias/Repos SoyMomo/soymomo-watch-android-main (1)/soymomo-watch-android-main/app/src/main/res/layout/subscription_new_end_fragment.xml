<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".sim.ui.fragments.newsubscription.NewSubscriptionEndFragment"
    android:background="@color/background_onboarding">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/insert_sim_animation"
        android:layout_width="@dimen/onboarding_animation_width"
        android:layout_height="@dimen/onboarding_animation_height"
        tools:src="@drawable/animation_placeholder_onboarding"
        android:layout_marginTop="@dimen/vertical_margin_large"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/insert_sim_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
        android:textAlignment="center"
        android:textSize="@dimen/add_watch_title_text_size"
        android:fontFamily="@font/poppins"
        android:textColor="@color/white"
        android:layout_marginVertical="@dimen/vertical_margin_large"
        app:layout_constraintTop_toBottomOf="@id/insert_sim_animation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/subscription_new_end_title" />

    <TextView
        android:id="@+id/insert_sim_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="12sp"
        android:layout_marginTop="@dimen/vertical_margin_large"
        android:layout_marginHorizontal="@dimen/horizontal_margin_extra_large"
        android:fontFamily="@font/poppins"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/insert_sim_title"
        android:text="@string/subscription_new_end_subtitle" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/shape_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vertical_margin_larger"
        android:src="@drawable/ic_purple_rectangle"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintBottom_toBottomOf="@id/text_display_phone_number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/insert_sim_description" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/watch_profile_picture"
        android:layout_width="@dimen/watch_card_profile_picture_size"
        android:layout_height="@dimen/watch_card_profile_picture_size"
        android:layout_marginStart="@dimen/horizontal_margin"
        android:layout_marginVertical="@dimen/vertical_margin"
        style="@style/contactImageView.noBorder"
        tools:srcCompat="@drawable/ic_soymomo_sim"
        app:layout_constraintTop_toTopOf="@id/shape_view"
        app:layout_constraintBottom_toBottomOf="@+id/shape_view"
        app:layout_constraintStart_toStartOf="@id/shape_view" />

    <TextView
        android:id="@+id/title_congratulations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subscription_new_end_label_congratulations"
        android:textSize="12sp"
        android:fontFamily="@font/poppins"
        android:textColor="@color/white"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        app:layout_constraintStart_toEndOf="@+id/watch_profile_picture"
        app:layout_constraintTop_toTopOf="@id/watch_profile_picture"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/text_display_phone_number_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/subscription_new_end_label_new_phone_number"
        android:layout_marginEnd="@dimen/horizontal_margin"
        android:fontFamily="@font/poppins"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/shape_view"
        app:layout_constraintStart_toStartOf="@+id/title_congratulations"
        app:layout_constraintTop_toBottomOf="@+id/title_congratulations"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/text_display_phone_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/horizontal_margin"
        android:layout_marginBottom="@dimen/vertical_margin_small"
        android:fontFamily="@font/poppins"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/shape_view"
        app:layout_constraintEnd_toEndOf="@id/shape_view"
        app:layout_constraintStart_toStartOf="@+id/title_congratulations"
        app:layout_constraintTop_toBottomOf="@+id/text_display_phone_number_title"
        app:layout_constraintVertical_bias="0.0"
        tools:text="+56989589426"
        android:visibility="gone"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/action_copy_content_clipboard"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="@dimen/vertical_margin_small"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        android:src="@drawable/ic_action_content_copy"
        app:layout_constraintBottom_toBottomOf="@id/shape_view"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/progress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        android:fontFamily="@font/poppins"
        android:text="@string/subscription_spinner_activating_sim"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/watch_profile_picture"
        app:layout_constraintTop_toTopOf="@id/watch_profile_picture"
        android:visibility="gone"/>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="@color/colorPrimaryDark"
        app:indicatorColor="@color/button_onboarding_enabled"
        app:indicatorSize="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/watch_profile_picture"
        app:layout_constraintEnd_toEndOf="@id/shape_view"
        app:layout_constraintStart_toStartOf="@id/watch_profile_picture"
        app:layout_constraintTop_toBottomOf="@+id/progress_title"
        app:trackColor="@color/colorPrimaryDark"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/title_no_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        android:fontFamily="@font/poppins"
        android:text="@string/subscription_activation_state_no_phone_title"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="visible"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/watch_profile_picture"
        app:layout_constraintTop_toTopOf="@id/watch_profile_picture" />

    <TextView
        android:id="@+id/text_no_phone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/subscription_activation_state_no_phone_text"
        android:layout_marginEnd="@dimen/horizontal_margin"
        android:fontFamily="@font/poppins"
        android:textColor="@color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/shape_view"
        app:layout_constraintStart_toStartOf="@+id/title_no_phone"
        app:layout_constraintTop_toBottomOf="@+id/title_no_phone"
        android:visibility="visible"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_next"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
        android:layout_marginVertical="@dimen/vertical_margin"
        android:backgroundTint="@color/button_onboarding_enabled"
        android:elevation="@dimen/card_elevation"
        android:fontFamily="@font/poppins"
        android:text="@string/subscription_button_finish"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="@dimen/first_momo_button_border"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shape_view"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>