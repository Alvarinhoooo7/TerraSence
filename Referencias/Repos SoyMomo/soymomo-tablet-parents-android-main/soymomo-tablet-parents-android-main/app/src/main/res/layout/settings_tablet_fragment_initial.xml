<?xml version="1.0" encoding="utf-8"?>
<!--
    Tablet settings root screen, rebuilt around a sectioned-list pattern
    that mirrors the iOS app's ParentalControlMainView and the watch
    parents Android's WatchSettingsV2Activity.

    Structure (top to bottom):
      - Purple toolbar with the SoyMomo logo and back arrow.
      - Lean hero MaterialCardView: model caption + child name + the
        tablet id underneath, with a compact edit FAB overlaid on the
        profile picture.
      - Quick action: a single Share chip beneath the hero card. The
        Lock and Screenshot chips ship in a follow-up slice (each needs
        cloud-function plumbing + confirmation / polling that's worth a
        dedicated review pass).
      - 4 sections (Safety / Control / Monitoring / Account), each a white
        rounded MaterialCardView wrapping a LinearLayout of <include>s
        pointing to item_tablet_setting_row. Section headers are <include>s
        of item_tablet_setting_section. Dug leads the Safety section as a
        row with a distinctive teal icon tile.

    Rows are wired in TabletInitialMenuFragment to existing nav actions —
    no nav-graph changes here, so this PR is contained.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:context=".tabletsettings.TabletInitialMenuFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/settings_header_logo"
            android:layout_width="96dp"
            android:layout_height="?attr/actionBarSize"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_vector_logo_no_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ToolbarTheme"
            app:layout_collapseMode="pin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:background="@drawable/settings_content_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:clipToPadding="false">

            <!-- HERO DEVICE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tablet_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorPrimary"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tablet_model"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:letterSpacing="0.05"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:textColor="@color/tablet_settings_card_model_caption"
                        android:textSize="11sp"
                        app:layout_constraintEnd_toStartOf="@id/tablet_profile_picture"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="TABLET PRO" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tablet_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        app:layout_constraintEnd_toStartOf="@id/tablet_profile_picture"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tablet_model"
                        tools:text="Baltazar Coddou" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/tablet_profile_picture"
                        style="@style/contactImageView"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/default_profile_pic"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/kid_profile_picture_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/edit_profile"
                        android:backgroundTint="@color/white"
                        android:foregroundTint="@color/white"
                        android:src="@drawable/ic_edit"
                        app:borderWidth="0dp"
                        app:elevation="2dp"
                        app:fabCustomSize="28dp"
                        android:layout_marginEnd="-8dp"
                        android:layout_marginBottom="-8dp"
                        app:layout_constraintBottom_toBottomOf="@id/tablet_profile_picture"
                        app:layout_constraintEnd_toEndOf="@id/tablet_profile_picture"
                        app:maxImageSize="14dp"
                        app:tint="@color/colorPrimary" />

                    <!-- Tablet id sits underneath, smaller, in white-with-alpha
                         so it whispers. Tap-to-copy will land in a follow-up
                         alongside the Lock/Screenshot quick actions. -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tablet_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textColor="@color/tablet_settings_card_id"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/tablet_profile_picture"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tablet_name"
                        tools:text="ID: Vj5eidtoX2" />

                    <!-- SIM phone number (Tablet.phone = subscription msisdn).
                         Gone by default: devices without a SIM card have no
                         number, and the pill below collapses back up to the ID. -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tablet_phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textColor="@color/tablet_settings_card_id"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toStartOf="@id/tablet_profile_picture"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tablet_id"
                        tools:text="Phone: +56 9 1234 5678"
                        tools:visibility="visible" />

                    <!-- Connection-status pill: colored dot + label (+ optional
                         battery). Bound in TabletInitialMenuFragment.bindPresence,
                         fed by TabletViewModel.loadTabletPresence(). -->
                    <LinearLayout
                        android:id="@+id/connection_status_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_presence_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tablet_phone">

                        <View
                            android:id="@+id/connection_status_dot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_presence_dot"
                            android:backgroundTint="@color/presence_checking" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/connection_status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/poppins"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            tools:text="Online" />

                        <ImageView
                            android:id="@+id/connection_status_battery_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_battery_100"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/connection_status_battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:fontFamily="@font/poppins"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="80%"
                            tools:visibility="visible" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- QUICK ACTION: DEVICE LOCK (remote block toggle).
                 Mirrors the iOS lock chip: locking asks for confirmation,
                 unlocking is immediate. Wired in TabletInitialMenuFragment. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lock_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/lock_icon_tile"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardBackgroundColor="@color/colorPrimary"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/lock_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:adjustViewBounds="true"
                            android:scaleType="centerInside"
                            android:importantForAccessibility="no"
                            android:src="@drawable/settings_blocks_tablet" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/lock_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:text="@string/tablet_settings_lock_title"
                        android:textColor="@color/colorPrimary"
                        android:textSize="15sp"
                        app:layout_constraintBottom_toTopOf="@id/lock_status"
                        app:layout_constraintEnd_toStartOf="@id/lock_switch"
                        app:layout_constraintStart_toEndOf="@id/lock_icon_tile"
                        app:layout_constraintTop_toTopOf="@id/lock_icon_tile"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/lock_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:textColor="@color/tablet_settings_row_chevron"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/lock_icon_tile"
                        app:layout_constraintEnd_toStartOf="@id/lock_switch"
                        app:layout_constraintStart_toEndOf="@id/lock_icon_tile"
                        app:layout_constraintTop_toBottomOf="@id/lock_title"
                        tools:text="Tablet active" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/lock_switch"
                        style="@style/Dug.Switch.GrayTrack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- QUICK ACTION: SHARE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_button"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/tablet_settings_share_bg"
                android:fontFamily="@font/poppins"
                android:letterSpacing="0"
                android:text="@string/tablet_settings_action_share"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/colorPrimary"
                app:rippleColor="@color/tablet_settings_share_ripple" />

            <!-- SECTION: SAFETY -->
            <include
                android:id="@+id/section_safety"
                layout="@layout/item_tablet_setting_section" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section_safety_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/row_dug"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_contacts"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_location_history"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_safety"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_safe_walking"
                        layout="@layout/item_tablet_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: CONTROL -->
            <include
                android:id="@+id/section_control"
                layout="@layout/item_tablet_setting_section" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section_control_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/row_apps_management"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_use_limit"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_school_mode"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_use_range"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_web_block"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_payments_block"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_ads_block"
                        layout="@layout/item_tablet_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: MONITORING -->
            <include
                android:id="@+id/section_monitoring"
                layout="@layout/item_tablet_setting_section" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section_monitoring_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/row_remote_screenshots"
                        layout="@layout/item_tablet_setting_row" />

                    <include
                        android:id="@+id/row_app_stats"
                        layout="@layout/item_tablet_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: ACCOUNT -->
            <include
                android:id="@+id/section_account"
                layout="@layout/item_tablet_setting_section" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section_account_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/row_link_device"
                        layout="@layout/item_tablet_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
