<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_layout"
    tools:context=".userprofile.ui.fragment.UserProfileMainFragment"
    android:background="@color/background_sim_step_card_title"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.5"
        android:background="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/app_bar_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="?attr/actionBarSize" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/user_profile_picture"
            android:layout_width="124dp"
            android:layout_height="124dp"
            style="@style/contactImageView"
            android:layout_marginTop="@dimen/vertical_margin_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_bar_guide"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_momo_space"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/user_profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/horizontal_margin_large"
            android:layout_marginVertical="@dimen/vertical_margin_small"
            style="@style/SimStepCardTitle"
            app:layout_constraintTop_toBottomOf="@id/user_profile_picture"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="José Feliú"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/user_profile_email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/horizontal_margin_large"
            android:layout_marginVertical="@dimen/vertical_margin_small"
            style="@style/SimDialogStepSubtitle"
            app:layout_constraintTop_toBottomOf="@id/user_profile_name"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="jose_feliu@soymomo.com"/>

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ToolbarTheme"
            app:layout_collapseMode="pin"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_layout"
            android:background="@drawable/sim_card_form_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/content_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/horizontal_margin_large"
                android:layout_marginStart="@dimen/vertical_margin_large"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/background_sim_step_card_title"
                android:textSize="@dimen/watch_settings_item_title_size"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/user_profile_main_title"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/vertical_margin"
                android:layout_marginBottom="@dimen/vertical_margin_extra_large"
                app:layout_constraintTop_toBottomOf="@id/content_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/edit_profile_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin_small"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    style="@style/SimContentCardView">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/edit_profile_card_image"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:srcCompat="@drawable/user_profile_edit_profile"
                            android:layout_margin="@dimen/vertical_margin_small"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/edit_profile_card_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_arrow_go"
                            android:layout_margin="@dimen/vertical_margin"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/edit_profile_card_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_edit_profile_title"
                            android:textStyle="bold"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/edit_profile_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/edit_profile_card_arrow"
                            app:layout_constraintBottom_toTopOf="@+id/edit_profile_card_subtitle"/>

                        <TextView
                            android:id="@+id/edit_profile_card_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_edit_profile_text"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toBottomOf="@+id/edit_profile_card_title"
                            app:layout_constraintStart_toEndOf="@+id/edit_profile_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/edit_profile_card_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/change_email_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin_small"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    style="@style/SimContentCardView">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/change_email_card_image"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:srcCompat="@drawable/user_profile_change_email"
                            android:layout_margin="@dimen/vertical_margin_small"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/change_email_card_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_arrow_go"
                            android:layout_margin="@dimen/vertical_margin"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/change_email_card_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_change_email_title"
                            android:textStyle="bold"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/change_email_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/change_email_card_arrow"
                            app:layout_constraintBottom_toTopOf="@+id/change_email_card_subtitle"/>

                        <TextView
                            android:id="@+id/change_email_card_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_change_email_text"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toBottomOf="@+id/change_email_card_title"
                            app:layout_constraintStart_toEndOf="@+id/change_email_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/change_email_card_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/erase_account_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin_small"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    style="@style/SimContentCardView">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/erase_account_card_image"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:srcCompat="@drawable/user_profile_erase_account"
                            android:layout_margin="@dimen/vertical_margin_small"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/erase_account_card_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_arrow_go"
                            android:layout_margin="@dimen/vertical_margin"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/erase_account_card_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_erase_account_title"
                            android:textStyle="bold"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/erase_account_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/erase_account_card_arrow"
                            app:layout_constraintBottom_toTopOf="@+id/erase_account_card_subtitle"/>

                        <TextView
                            android:id="@+id/erase_account_card_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_erase_account_text"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toBottomOf="@+id/erase_account_card_title"
                            app:layout_constraintStart_toEndOf="@+id/erase_account_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/erase_account_card_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/social_media_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin_small"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    style="@style/SimContentCardView">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/social_media_card_image"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:srcCompat="@drawable/user_profile_social_media"
                            android:layout_margin="@dimen/vertical_margin_small"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/social_media_card_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_arrow_go"
                            android:layout_margin="@dimen/vertical_margin"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/social_media_card_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_social_media_title"
                            android:textStyle="bold"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/social_media_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/social_media_card_arrow"
                            app:layout_constraintBottom_toTopOf="@+id/social_media_card_subtitle"/>

                        <TextView
                            android:id="@+id/social_media_card_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_social_media_text"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toBottomOf="@+id/social_media_card_title"
                            app:layout_constraintStart_toEndOf="@+id/social_media_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/social_media_card_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/change_password_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin_small"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    style="@style/SimContentCardView">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/change_password_card_image"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:srcCompat="@drawable/user_profile_change_password"
                            android:layout_margin="@dimen/vertical_margin_small"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/change_password_card_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_arrow_go"
                            android:layout_margin="@dimen/vertical_margin"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/change_password_card_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_change_password_title"
                            android:textStyle="bold"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/change_password_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/change_password_card_arrow"
                            app:layout_constraintBottom_toTopOf="@+id/change_password_card_subtitle"/>

                        <TextView
                            android:id="@+id/change_password_card_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_change_password_text"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toBottomOf="@+id/change_password_card_title"
                            app:layout_constraintStart_toEndOf="@+id/change_password_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/change_password_card_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/log_out_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin_small"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    style="@style/SimContentCardView">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/log_out_card_image"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:srcCompat="@drawable/session_app_log_out"
                            android:layout_margin="@dimen/vertical_margin_small"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/log_out_card_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_arrow_go"
                            android:layout_margin="@dimen/vertical_margin"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/log_out_card_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_log_out_title"
                            android:textStyle="bold"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/log_out_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/log_out_card_arrow"
                            app:layout_constraintBottom_toTopOf="@+id/log_out_card_subtitle"/>

                        <TextView
                            android:id="@+id/log_out_card_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/user_profile_log_out_text"
                            style="@style/SimContentCardViewContent"
                            app:layout_constraintTop_toBottomOf="@+id/log_out_card_title"
                            app:layout_constraintStart_toEndOf="@+id/log_out_card_image"
                            app:layout_constraintEnd_toStartOf="@+id/log_out_card_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
