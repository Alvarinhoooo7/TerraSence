<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/watch_settings_profile_background"
            app:collapsedTitleTextAppearance="@style/CollapsingToolbarCollapsed"
            app:contentScrim="@color/colorPrimary"
            app:expandedTitleTextAppearance="@style/CollapsingToolbarExpanded"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/SimStepCardHeader.Under"
                app:layout_collapseMode="parallax"
                app:layout_scrollFlags="scroll|enterAlwaysCollapsed">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/app_bar_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="?attr/actionBarSize" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/plan_card_background"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_percent=".6"
                    app:srcCompat="@drawable/ic_plan_background"
                    app:layout_constraintTop_toBottomOf="@+id/app_bar_guide"
                    app:layout_constraintBottom_toTopOf="@+id/subscription_form_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintDimensionRatio="w,160:234"/>

                <include
                    layout="@layout/item_sim_plan_small"
                    android:id="@+id/plan_info"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="24dp"
                    app:layout_constraintTop_toTopOf="@+id/plan_card_background"
                    app:layout_constraintBottom_toBottomOf="@+id/plan_card_background"
                    app:layout_constraintStart_toStartOf="@+id/plan_card_background"
                    app:layout_constraintEnd_toEndOf="@+id/plan_card_background" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/subscription_form_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin_large"
                    android:padding="@dimen/horizontal_margin"
                    android:background="@drawable/sim_card_form_background"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/subscription_form_title"
                    android:textAlignment="center"
                    android:textColor="@color/background_sim_step_card_title"
                    android:textSize="@dimen/add_watch_title_text_size"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/plan_card_background" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:theme="@style/ToolbarTheme"
                android:background="@color/background_sim_step_card_title"
                app:layout_collapseMode="pin"/>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionGroup="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/horizontal_margin_large"
            android:background="@color/white"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Error Message -->
            <LinearLayout
                android:id="@+id/form_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/sim_card_form_error_background"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_error_form" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:textColor="@color/form_error_text"
                    android:text="@string/subscription_form_error_message"/>

            </LinearLayout>

            <!-- Personal Information -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_name"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@+id/form_error_message">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/background_sim_step_card_title"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_last_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_last_name"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_birthday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_birthday"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_last_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_personal_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_personal_id"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_birthday">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contact Information -->
            <com.hbb20.CountryCodePicker
                android:id="@+id/ccp"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                app:ccp_autoDetectCountry="true"
                app:ccp_autoDetectLanguage="true"
                app:ccp_contentColor="@color/background_sim_step_card_title"
                app:ccp_countryAutoDetectionPref="SIM_NETWORK_LOCALE"
                app:ccp_defaultLanguage="SPANISH"
                app:ccp_defaultNameCode="CL"
                app:ccp_rememberLastSelection="true"
                app:ccp_showNameCode="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/til_user_phone"
                app:layout_constraintBottom_toBottomOf="@+id/til_user_phone"
                tools:text="+56"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_user_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/subscription_form_label_phone_number"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintStart_toEndOf="@+id/ccp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/til_personal_id">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_email"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_user_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Address Information -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/address_label"
                style="@style/TextViewSubscriptionFormLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subscription_form_label_address"
                android:textSize="@dimen/add_watch_form_label"
                android:textColor="@color/background_sim_step_card_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/til_email" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_placeholder_address"
                style="@style/SimTextInputLayoutStyle"
                app:endIconDrawable="@drawable/ic_search"
                app:endIconMode="custom"
                app:endIconTint="@color/white"
                app:errorIconDrawable="@drawable/ic_search"
                app:errorIconTint="@color/white"
                app:layout_constraintTop_toBottomOf="@id/address_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress"
                    android:clickable="true"
                    android:focusable="false"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_optional_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/subscription_form_placeholder_optional_address"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_address">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_city"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_optional_address">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_state"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_city">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_postal_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:hint="@string/subscription_form_label_postal_code"
                style="@style/SimTextInputLayoutStyle"
                app:layout_constraintTop_toBottomOf="@id/til_state">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress"
                    android:textColor="@color/background_sim_step_card_title" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Terms and Privacy -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/checkbox_tc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/SimSwitch"
                android:layout_marginTop="@dimen/vertical_margin_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/til_postal_code"
                tools:checked="true" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_view_tc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vertical_margin_small"
                android:fontFamily="@font/poppins"
                android:text="@string/subscription_form_label_checkboxes_tc"
                android:textColor="@color/background_sim_step_card_title"
                android:textSize="@dimen/add_watch_form_label"
                app:layout_constraintStart_toEndOf="@+id/checkbox_tc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/checkbox_tc"
                app:layout_constraintBottom_toBottomOf="@+id/checkbox_tc"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/checkbox_np"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/SimSwitch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/checkbox_tc"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_view_np"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vertical_margin_small"
                android:fontFamily="@font/poppins"
                android:text="@string/subscription_form_label_checkboxes_pc"
                android:textColor="@color/background_sim_step_card_title"
                android:textSize="@dimen/add_watch_form_label"
                app:layout_constraintStart_toEndOf="@+id/checkbox_np"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/checkbox_np"
                app:layout_constraintBottom_toBottomOf="@+id/checkbox_np"/>

            <!-- Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_next"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginVertical="@dimen/vertical_margin"
                android:text="@string/subscription_button_next"
                style="@style/SimButton.Positive"
                app:layout_constraintTop_toBottomOf="@+id/checkbox_np"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_indicator"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:elevation="16dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/colorPrimaryDark"
                app:indicatorColor="@color/white"
                app:trackColor="@color/colorPrimaryDark"
                app:layout_constraintTop_toTopOf="@id/button_next"
                app:layout_constraintStart_toStartOf="@id/button_next"
                app:layout_constraintEnd_toEndOf="@id/button_next"
                app:layout_constraintBottom_toBottomOf="@id/button_next" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>