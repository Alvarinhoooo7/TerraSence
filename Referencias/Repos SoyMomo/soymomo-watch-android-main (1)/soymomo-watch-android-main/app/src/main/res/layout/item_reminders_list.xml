<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reminder_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="36dp"
    app:cardElevation="@dimen/card_elevation">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vertical_margin_small"
        android:paddingTop="@dimen/vertical_margin_small"
        android:paddingEnd="@dimen/vertical_margin_small"
        android:paddingBottom="@dimen/vertical_margin_small">

        <TextView
            android:id="@+id/reminder_emoji"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            app:layout_constraintDimensionRatio="1"
            app:autoSizeTextType="uniform"
            android:padding="4dp"
            android:textColor="@color/black"
            app:layout_constraintWidth_percent=".3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="😄" />

        <TextView
            android:id="@+id/title_reminder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/reminders_separation_days_of_week"
            android:layout_marginTop="4dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/poppins"
            android:textColor="@color/colorPrimary"
            app:layout_constraintStart_toEndOf="@id/reminder_emoji"
            app:layout_constraintTop_toTopOf="@+id/reminder_emoji"
            app:layout_constraintEnd_toStartOf="@id/switch_state_reminder"
            tools:text="Time to wake up" />

        <TextView
            android:id="@+id/time_and_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/poppins"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/reminder_emoji"
            app:layout_constraintEnd_toStartOf="@+id/switch_state_reminder"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/reminder_emoji"
            app:layout_constraintTop_toBottomOf="@id/title_reminder"
            tools:text="LMMJVSD 8:00 - 8:30" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_state_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:switchPadding="4dp"
            style="@style/ReminderSwitch"
            app:layout_constraintBottom_toBottomOf="@+id/reminder_emoji"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/reminder_emoji" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>