<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".tabletsettings.times.schoolmode.SchoolModeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:collapsedTitleTextAppearance="@style/CollapsingToolbarCollapsed"
                app:contentScrim="@color/colorPrimary"
                app:expandedTitleTextAppearance="@style/CollapsingToolbarExpanded"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/header"
                    style="@style/SimStepCardHeader.Over"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="parallax"
                    app:layout_scrollFlags="scroll|enterAlwaysCollapsed">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/app_bar_guide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_begin="?attr/actionBarSize" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/header_image"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintHeight_percent=".4"
                        app:srcCompat="@drawable/settings_school_mode_image"
                        app:layout_constraintTop_toBottomOf="@id/app_bar_guide"
                        app:layout_constraintBottom_toTopOf="@+id/header_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/header_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
                        android:layout_marginVertical="@dimen/vertical_margin"
                        android:text="@string/card_school_mode_title"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@id/header_image"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@color/background_sim_step_card_title"
                    android:theme="@style/ToolbarTheme"
                    app:layout_collapseMode="pin" />

            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:transitionGroup="true"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/app_bar_layout_blocks"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@color/white">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/variable_option_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/horizontal_margin"
                    android:layout_marginVertical="@dimen/vertical_margin"
                    android:elevation="@dimen/card_elevation"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:background="@drawable/settings_card_design_white">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/status_image"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/settings_school_mode_icon"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        android:layout_marginVertical="@dimen/vertical_margin"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/status_title"
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        android:text="@string/card_school_mode_title"
                        app:layout_constraintTop_toTopOf="@id/status_image"
                        app:layout_constraintStart_toEndOf="@+id/status_image"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/status_description"
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary"
                        android:fontFamily="@font/poppins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        android:text="@string/settings_variable_status_disabled"
                        app:layout_constraintTop_toBottomOf="@+id/status_title"
                        app:layout_constraintStart_toEndOf="@+id/status_image"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/status_switch"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/dug_switch_color"
                        android:enabled="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin_large"
                    app:layout_constraintTop_toBottomOf="@+id/variable_option_status"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:visibility="invisible"
                    tools:visibility="visible"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_daily_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/vertical_margin"
                    app:layout_constraintTop_toBottomOf="@+id/variable_option_status"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:visibility="invisible"
                    tools:visibility="visible">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/days_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_days"
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimary"
                        app:fontFamily="@font/poppins_semibold"
                        android:textAlignment="center"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/days_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:justifyContent="space_evenly"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/days_title">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_monday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/monday_initial_narrow"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_bold"
                            android:textAlignment="center"
                            app:backgroundTint="@color/colorSecondary"
                            app:cornerRadius="@dimen/button_corner_radius"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_tuesday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/horizontal_margin_smallest"
                            android:text="@string/tuesday_initial_narrow"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_bold"
                            android:textAlignment="center"
                            app:backgroundTint="@color/colorSecondary"
                            app:cornerRadius="@dimen/button_corner_radius"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_wednesday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/horizontal_margin_smallest"
                            android:text="@string/wednesday_initial_narrow"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_bold"
                            android:textAlignment="center"
                            app:backgroundTint="@color/colorSecondary"
                            app:cornerRadius="@dimen/button_corner_radius"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_thursday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/horizontal_margin_smallest"
                            android:text="@string/thursday_initial_narrow"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_bold"
                            android:textAlignment="center"
                            app:backgroundTint="@color/colorSecondary"
                            app:cornerRadius="@dimen/button_corner_radius"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_friday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/horizontal_margin_smallest"
                            android:text="@string/friday_initial_narrow"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_bold"
                            android:textAlignment="center"
                            app:backgroundTint="@color/colorSecondary"
                            app:cornerRadius="@dimen/button_corner_radius"/>

                    </com.google.android.flexbox.FlexboxLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/daily_schedule_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/daily_schedule"
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimary"
                        app:fontFamily="@font/poppins_semibold"
                        android:textAlignment="center"
                        android:layout_marginVertical="@dimen/vertical_margin_medium"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        app:layout_constraintTop_toBottomOf="@id/days_layout"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/from_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary"
                        android:fontFamily="@font/poppins"
                        app:layout_constraintTop_toBottomOf="@id/daily_schedule_title"
                        app:layout_constraintStart_toStartOf="@id/from_time_set"
                        app:layout_constraintBottom_toTopOf="@id/from_time_set"
                        android:text="@string/usage_hours_range_from" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/from_time_set"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:background="@drawable/settings_card_design_primary"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:paddingHorizontal="@dimen/horizontal_margin"
                        android:paddingVertical="@dimen/vertical_margin_smaller"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@+id/from_text"
                        app:layout_constraintStart_toStartOf="@id/daily_schedule_title"
                        app:layout_constraintEnd_toStartOf="@id/to_time_set"
                        android:text="@string/three_points" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/to_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary"
                        android:fontFamily="@font/poppins"
                        app:layout_constraintTop_toTopOf="@id/from_text"
                        app:layout_constraintStart_toStartOf="@id/to_time_set"
                        app:layout_constraintBottom_toTopOf="@id/to_time_set"
                        android:text="@string/usage_hours_range_to" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/to_time_set"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:background="@drawable/settings_card_design_primary"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
                        android:paddingHorizontal="@dimen/horizontal_margin"
                        android:paddingVertical="@dimen/vertical_margin_smaller"
                        android:textAlignment="center"
                        app:layout_constraintTop_toTopOf="@id/from_time_set"
                        app:layout_constraintStart_toEndOf="@id/from_time_set"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:text="@string/three_points" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/allowed_apps_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allowed_apps"
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimary"
                        app:fontFamily="@font/poppins_semibold"
                        android:layout_marginVertical="@dimen/vertical_margin_medium"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        app:layout_constraintTop_toBottomOf="@id/from_time_set"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ViewFlipper
                        android:id="@+id/allowed_apps_view_flipper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/allowed_apps_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/allowed_apps_recycler_view"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                tools:itemCount="2"
                                tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:listitem="@layout/item_app_dismissible"
                                android:orientation="vertical" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/add_apps_image"
                                android:layout_width="52dp"
                                android:layout_height="48dp"
                                android:src="@drawable/settings_add_app_image"
                                android:layout_marginVertical="@dimen/vertical_margin"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toTopOf="@id/add_apps_text"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/add_apps_text"
                                style="@style/ParentControlVariableFragmentSubTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/card_school_mode_add_apps"
                                app:layout_constraintTop_toBottomOf="@id/add_apps_image"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </ViewFlipper>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/add_app"
                        android:textAllCaps="false"
                        style="@style/ParentControlButtonText"
                        app:backgroundTint="@color/colorSecondary"
                        app:cornerRadius="@dimen/button_corner_radius"
                        android:layout_marginVertical="@dimen/vertical_margin_large"
                        android:layout_marginHorizontal="@dimen/horizontal_margin"
                        app:layout_constraintTop_toBottomOf="@id/allowed_apps_view_flipper"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.constraintlayout.widget.ConstraintLayout>