        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Round100</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Silence-time list: purple SwitchCompat. showText=false guards a
         SwitchCompat.makeLayout NPE (null switch text -> StaticLayout during row
         measure) seen on Android 16/17. The crash lives in SwitchCompat itself,
         so it is theme-independent and also affects MaterialSwitch (which extends
         SwitchCompat) — keep this guard on every switch in a measured row. The
         switch shows no on/off text, so this is a visual no-op. -->
    <style name="SilenceSwitch">
        <item name="thumbTint">@color/white</item>
        <item name="trackTint">@color/colorPrimary</item>
        <item name="showText">false</item>
        <item name="android:showText">false</item>
    </style>

