<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="32dp"
    android:background="@drawable/settings_card_design_white">

    <TextView
        android:id="@+id/variable_title"
        style="@style/ParentControlVariableFragmentTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/settings_stats_subtitle"
        android:maxLines="1"
        android:ellipsize="end"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeMaxTextSize="22sp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stats_change"
        />

    <ImageView
        android:id="@+id/stats_change"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintEnd_toStartOf="@+id/than_last_week"
        app:layout_constraintBottom_toBottomOf="@+id/than_last_week"
        android:src="@drawable/stats_down"
        android:layout_marginRight="8dp"
        android:visibility="invisible"/>

    <TextView
        android:id="@+id/than_last_week"
        style="@style/ParentControlNormalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_stats_daily_average_less_than"
        app:layout_constraintTop_toTopOf="@+id/variable_title"
        app:layout_constraintBottom_toBottomOf="@+id/variable_title"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="invisible"
        android:textSize="10sp"
        />

    <!-- Period selector lives OUTSIDE the chart card so the chart gets the full width/height. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/period_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleSelection="true"
        app:layout_constraintTop_toBottomOf="@+id/variable_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_today"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/settings_stats_today"
            android:textSize="12sp"
            app:chipMinTouchTargetSize="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_week"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:checked="true"
            android:text="@string/settings_stats_week"
            android:textSize="12sp"
            app:chipMinTouchTargetSize="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_month"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/settings_stats_month"
            android:textSize="12sp"
            app:chipMinTouchTargetSize="0dp" />

    </com.google.android.material.chip.ChipGroup>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/app_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/period_group"
        android:background="@drawable/settings_card_design_white"
        android:elevation="4dp"
        android:layout_marginTop="16dp"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:layout_marginHorizontal="4dp">

        <TextView
            android:id="@+id/time_use"
            style="@style/ParentControlBigNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="@string/settings_stats_daily_average_time"
            app:layout_constraintTop_toBottomOf="@+id/app_use"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginLeft="16dp"/>

        <TextView
            android:id="@+id/app_use"
            style="@style/ParentControlNormalTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_stats_daily_average"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginLeft="16dp"
            android:textAlignment="gravity"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/choose_stats"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginRight="16dp"
            android:background="@drawable/settings_card_design_grey">

            <com.google.android.material.chip.Chip
                android:id="@+id/week"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                app:chipMinTouchTargetSize="0dp"
                android:text="@string/settings_stats_week"
                app:chipBackgroundColor="@color/colorPrimary"
                android:textSize="8sp"
                app:chipStartPadding="8dp"
                app:chipEndPadding="8dp"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/category"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/category"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                app:chipMinTouchTargetSize="0dp"
                android:text="@string/settings_stats_categories"
                app:chipBackgroundColor="@color/colorGrey"
                android:textSize="8sp"
                android:textColor="@color/grey_600"
                app:chipStartPadding="8dp"
                app:chipEndPadding="8dp"
                app:layout_constraintStart_toEndOf="@+id/week"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/bar_chart"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            app:layout_constraintTop_toBottomOf="@+id/time_use"
            />

        <ProgressBar
            android:id="@+id/chart_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@+id/bar_chart"
            app:layout_constraintBottom_toBottomOf="@+id/bar_chart"
            app:layout_constraintStart_toStartOf="@+id/bar_chart"
            app:layout_constraintEnd_toEndOf="@+id/bar_chart" />

        <!-- App-color legend (rendered here, not by the chart, to avoid MPAndroidChart's
             stale-legend crash when the stack count changes between periods). -->
        <LinearLayout
            android:id="@+id/chart_legend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/bar_chart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:id="@+id/legend_item_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="12dp">
                <View android:id="@+id/legend_dot_1" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginEnd="4dp"/>
                <TextView android:id="@+id/legend_label_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/grey_600" android:maxLines="1" android:ellipsize="end" tools:text="YouTube"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/legend_item_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="12dp">
                <View android:id="@+id/legend_dot_2" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginEnd="4dp"/>
                <TextView android:id="@+id/legend_label_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/grey_600" android:maxLines="1" android:ellipsize="end" tools:text="Chrome"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/legend_item_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginEnd="12dp">
                <View android:id="@+id/legend_dot_3" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginEnd="4dp"/>
                <TextView android:id="@+id/legend_label_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/grey_600" android:maxLines="1" android:ellipsize="end" tools:text="Music"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/legend_item_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <View android:id="@+id/legend_dot_4" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginEnd="4dp"/>
                <TextView android:id="@+id/legend_label_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/grey_600" android:maxLines="1" android:ellipsize="end" tools:text="Others"/>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/social_media"
            style="@style/ParentControlAppCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_social_media"
            android:textColor="@color/colorChipSocialMedia"
            app:layout_constraintTop_toBottomOf="@+id/bar_chart"
            app:layout_constraintStart_toStartOf="parent"
            android:textAlignment="gravity"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/social_media_time"
            style="@style/ParentControlAppCardDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="@string/settings_stats_daily_average_time"
            app:layout_constraintTop_toBottomOf="@+id/social_media"
            app:layout_constraintStart_toStartOf="parent"
            android:textAlignment="gravity"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/leisure"
            style="@style/ParentControlAppCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_leisure"
            app:layout_constraintTop_toBottomOf="@+id/social_media_time"
            app:layout_constraintStart_toStartOf="parent"
            android:textAlignment="gravity"
            android:layout_marginTop="4dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/leisure_time"
            style="@style/ParentControlAppCardDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="@string/settings_stats_daily_average_time"
            app:layout_constraintTop_toBottomOf="@+id/leisure"
            app:layout_constraintStart_toStartOf="parent"
            android:textAlignment="gravity"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/learning"
            style="@style/ParentControlAppCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_learning"
            android:textColor="@color/colorSecondary"
            app:layout_constraintTop_toBottomOf="@+id/bar_chart"
            app:layout_constraintStart_toEndOf="@+id/social_media"
            android:textAlignment="gravity"
            android:layout_marginLeft="40dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/learning_time"
            style="@style/ParentControlAppCardDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="@string/settings_stats_daily_average_time"
            app:layout_constraintTop_toBottomOf="@+id/learning"
            app:layout_constraintStart_toEndOf="@+id/social_media"
            android:textAlignment="gravity"
            android:layout_marginLeft="40dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/communication"
            style="@style/ParentControlAppCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_communication"
            android:textColor="@color/colorChipDrugs"
            app:layout_constraintTop_toBottomOf="@+id/learning_time"
            app:layout_constraintStart_toEndOf="@+id/social_media"
            android:textAlignment="gravity"
            android:layout_marginTop="4dp"
            android:layout_marginLeft="40dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/communication_time"
            style="@style/ParentControlAppCardDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="@string/settings_stats_daily_average_time"
            app:layout_constraintTop_toBottomOf="@+id/communication"
            app:layout_constraintStart_toEndOf="@+id/social_media"
            android:textAlignment="gravity"
            android:layout_marginLeft="40dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/other"
            style="@style/ParentControlAppCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_others"
            android:textColor="@color/grey_600"
            app:layout_constraintTop_toBottomOf="@+id/bar_chart"
            app:layout_constraintStart_toEndOf="@id/learning"
            android:textAlignment="gravity"
            android:layout_marginLeft="40dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/other_time"
            style="@style/ParentControlAppCardDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="@string/settings_stats_daily_average_time"
            app:layout_constraintTop_toBottomOf="@+id/other"
            app:layout_constraintStart_toEndOf="@id/learning"
            android:textAlignment="gravity"
            android:layout_marginLeft="40dp"
            android:visibility="gone"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/insight_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/app_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:orientation="vertical"
                android:background="@drawable/settings_card_design_grey"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Top app" android:textColor="@color/grey_600" android:textSize="11sp"
                    tools:ignore="HardcodedText" />
                <TextView android:id="@+id/insight_top_app" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textColor="@color/colorPrimary" android:textSize="14sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end" tools:text="YouTube" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:orientation="vertical"
                android:background="@drawable/settings_card_design_grey"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Apps used" android:textColor="@color/grey_600" android:textSize="11sp"
                    tools:ignore="HardcodedText" />
                <TextView android:id="@+id/insight_apps_used" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textColor="@color/colorPrimary" android:textSize="14sp" android:textStyle="bold"
                    tools:text="2" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:orientation="vertical"
                android:background="@drawable/settings_card_design_grey"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Busiest day" android:textColor="@color/grey_600" android:textSize="11sp"
                    tools:ignore="HardcodedText" />
                <TextView android:id="@+id/insight_busiest" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textColor="@color/colorPrimary" android:textSize="14sp" android:textStyle="bold"
                    tools:text="Mar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:orientation="vertical"
                android:background="@drawable/settings_card_design_grey"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Daily average" android:textColor="@color/grey_600" android:textSize="11sp"
                    tools:ignore="HardcodedText" />
                <TextView android:id="@+id/insight_avg" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textColor="@color/colorPrimary" android:textSize="14sp" android:textStyle="bold"
                    tools:text="0h 32m" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/white"
        android:backgroundTint="@color/white"
        android:nestedScrollingEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/insight_grid"
        app:spanCount="1"
        tools:itemCount="6"
        tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_apps_use"
        tools:orientation="vertical"
        tools:scrollbars="vertical" />

</androidx.constraintlayout.widget.ConstraintLayout>