<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:checkable="true"
    android:focusable="true"
    android:clickable="true"
    app:checkedIconMargin="22dp"
    app:checkedIconSize="42dp"
    app:cardCornerRadius="40dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <include
            android:id="@+id/main_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/linkwatch_cardview_mainview_childdata_image">

        </include>

        <TextView
            android:id="@+id/card_title_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/LinkWatchDescriptionTextPurple"
            android:text="@string/child_data_title"
            app:layout_constraintStart_toEndOf="@id/main_image"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginHorizontal="16dp"
            android:textStyle="bold">

        </TextView>

        <TextView
            android:id="@+id/card_description_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/LinkWatchDescriptionTextPurple"
            android:text="@string/child_data_description"
            app:layout_constraintStart_toStartOf="@id/card_title_textview"
            app:layout_constraintTop_toBottomOf="@id/card_title_textview">

        </TextView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>