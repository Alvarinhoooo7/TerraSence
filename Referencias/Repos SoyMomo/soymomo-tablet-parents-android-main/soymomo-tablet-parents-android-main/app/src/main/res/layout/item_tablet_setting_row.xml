<?xml version="1.0" encoding="utf-8"?>
<!--
    Single row in the sectioned tablet settings list. Mirrors the watch
    parents Android item_watch_setting_v2 + the iOS PCSettingsRow:
    purple icon tile (44dp rounded square) + title + chevron + an
    indented hairline divider that gets toggled off on the last row of
    each section.

    Used via <include> from settings_tablet_fragment_initial.xml — each
    section contains a vertical stack of these, wrapped in a white
    MaterialCardView so the whole section reads as a single rounded
    card.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <!-- Purple rounded tile that hosts the feature illustration. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/row_icon_tile"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardBackgroundColor="@color/colorPrimary"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/row_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            tools:src="@drawable/settings_feature_contacts" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="@font/poppins"
        android:textColor="@color/colorPrimary"
        android:textSize="15sp"
        android:textStyle="normal"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/row_chevron"
        app:layout_constraintStart_toEndOf="@id/row_icon_tile"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Contactos" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/row_chevron"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_arrow_forward"
        android:importantForAccessibility="no"
        app:tint="@color/tablet_settings_row_chevron"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Hairline separator under the row. The last row of each section
         hides this via row_divider.visibility = GONE in Kotlin. -->
    <View
        android:id="@+id/row_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="74dp"
        android:background="@color/tablet_settings_row_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
