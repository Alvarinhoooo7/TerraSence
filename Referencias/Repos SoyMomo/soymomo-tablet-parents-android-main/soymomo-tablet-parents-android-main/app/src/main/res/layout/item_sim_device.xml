<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/device_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/vertical_margin_small"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        style="@style/SimContentCardView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RadioButton
                android:id="@+id/device_radio_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/vertical_margin_small"
                android:button="@drawable/device_selected_radio_btn"
                android:buttonTint="@color/transparent"
                android:buttonTintMode="add"
                app:layout_constraintWidth_percent=".1"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:checked="true"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/device_profile_picture"
                android:layout_width="@dimen/device_card_profile_picture_size"
                android:layout_height="@dimen/device_card_profile_picture_size"
                android:layout_marginHorizontal="@dimen/horizontal_margin"
                android:layout_marginVertical="@dimen/vertical_margin"
                style="@style/contactImageView.noBorder"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:srcCompat="@drawable/ic_momo_space"/>

            <TextView
                android:id="@+id/device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin"
                style="@style/SimContentCardTargetViewTitle"
                app:layout_constraintStart_toEndOf="@id/device_profile_picture"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/device_radio_button"
                tools:text="José Feliú" />

            <TextView
                android:id="@+id/device_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/SimContentCardViewContent"
                tools:text="Model: SoyMomo Space 2.0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/device_profile_picture"
                app:layout_constraintTop_toBottomOf="@id/device_name"
                app:layout_constraintEnd_toStartOf="@+id/device_radio_button"/>

            <TextView
                android:id="@+id/device_imei"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/SimContentCardViewContent"
                tools:text="IMEI: 8696090349234"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/device_profile_picture"
                app:layout_constraintTop_toBottomOf="@id/device_model"
                app:layout_constraintEnd_toStartOf="@+id/device_radio_button" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>