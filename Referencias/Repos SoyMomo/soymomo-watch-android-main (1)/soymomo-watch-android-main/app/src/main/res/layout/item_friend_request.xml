<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_margin="4dp"
        android:minHeight="48dp">

        <ImageView
            android:id="@+id/contact_image_frame"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:srcCompat="@drawable/ic_myfriends_profile_frame"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/contact_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_default_avatar"
            app:layout_constraintTop_toTopOf="@+id/contact_image_frame"
            app:layout_constraintBottom_toBottomOf="@+id/contact_image_frame"
            app:layout_constraintStart_toStartOf="@+id/contact_image_frame"
            app:layout_constraintEnd_toEndOf="@+id/contact_image_frame"
            style="@style/contactImageView"/>

        <TextView
            android:id="@+id/watch_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/watch_id"
            app:layout_constraintStart_toEndOf="@+id/contact_image_frame"
            app:layout_constraintVertical_chainStyle="packed"/>

        <TextView
            android:id="@+id/watch_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintTop_toBottomOf="@id/watch_name"
            app:layout_constraintBottom_toTopOf="@+id/request_status"
            app:layout_constraintStart_toEndOf="@id/contact_image_frame"/>

        <TextView
            android:id="@+id/request_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintTop_toBottomOf="@id/watch_id"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/contact_image_frame"/>

        <ImageButton
            android:id="@+id/accept_button"
            android:layout_width="@dimen/pending_request_button_size"
            android:layout_height="@dimen/pending_request_button_size"
            android:scaleType="centerInside"
            android:background="@color/transparent"
            android:layout_marginHorizontal="8dp"
            app:srcCompat="@drawable/ic_accept_request"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/reject_button"/>
        <ImageButton
            android:id="@+id/reject_button"
            android:layout_width="@dimen/pending_request_button_size"
            android:layout_height="@dimen/pending_request_button_size"
            android:scaleType="centerInside"
            android:background="@color/transparent"
            android:layout_marginHorizontal="8dp"
            app:srcCompat="@drawable/ic_reject_request"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>