<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_layout"
    tools:context=".sim.ui.fragments.payment.ApioConfirmSubscriptionFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/watch_settings_profile_background"
            app:collapsedTitleTextAppearance="@style/CollapsingToolbarCollapsed"
            app:contentScrim="@color/colorPrimary"
            app:expandedTitleTextAppearance="@style/CollapsingToolbarExpanded"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/SimStepCardHeader.Under"
                app:layout_collapseMode="parallax"
                app:layout_scrollFlags="scroll|enterAlwaysCollapsed">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/app_bar_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="?attr/actionBarSize" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/plan_card_background"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_percent=".6"
                    app:srcCompat="@drawable/ic_plan_background"
                    app:layout_constraintTop_toBottomOf="@+id/app_bar_guide"
                    app:layout_constraintBottom_toTopOf="@+id/subscription_payment_apio_user_cards_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintDimensionRatio="w,160:234"/>

                <include
                    layout="@layout/item_sim_plan_small"
                    android:id="@+id/plan_info"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="24dp"
                    app:layout_constraintTop_toTopOf="@+id/plan_card_background"
                    app:layout_constraintBottom_toBottomOf="@+id/plan_card_background"
                    app:layout_constraintStart_toStartOf="@+id/plan_card_background"
                    app:layout_constraintEnd_toEndOf="@+id/plan_card_background" />

                <TextView
                    android:id="@+id/subscription_payment_apio_user_cards_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin_large"
                    android:padding="@dimen/horizontal_margin"
                    android:background="@drawable/sim_card_form_background"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="@color/background_sim_step_card_title"
                    android:textSize="@dimen/add_watch_title_text_size"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:text="@string/subscription_payment_apio_confirm_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/plan_card_background" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:theme="@style/ToolbarTheme"
                android:background="@color/background_sim_step_card_title"
                app:layout_collapseMode="pin"/>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <include
        layout="@layout/item_subscription_apio_card"
        android:id="@+id/apio_card_info"
        android:layout_width="0dp"
        android:layout_height="192dp"
        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
        app:layout_constraintTop_toBottomOf="@id/app_bar_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_confirm_subscription"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
        android:layout_marginBottom="@dimen/vertical_margin_small"
        android:text="@string/subscription_button_confirm_subscription"
        style="@style/SimButton.Positive"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:enabled="true"/>

</androidx.constraintlayout.widget.ConstraintLayout>