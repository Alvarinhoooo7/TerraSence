<resources>
    <style name="TextViewSubscriptionFormLabel">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">@dimen/vertical_margin</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextViewOnBoardingDescription">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">12sp</item>
    </style>
    
    <style name="TextViewEditFirstContactLabel">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>
    
    <style name="TextViewEditFirstContactText">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="Theme.AppCompat.Light.NoActionBar.FullScreen" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <style name="ToolbarWhiteTheme" parent="@style/ThemeOverlay.AppCompat.ActionBar">
        <!-- Customize color of navigation drawer icon and back arrow -->
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="TitleToolbarWhite">
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="MaterialAppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- ===== Material 3 color roles (light) ===== -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <!-- Preserve the app's dark-purple status bar (was driven by the M2
             colorPrimaryDark attr, which M3 no longer maps automatically). -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <!-- Keep collapsing-toolbar titles hidden (screens draw their own). -->
        <item name="collapsingToolbarLayoutStyle">@style/Widget.App.CollapsingToolbar</item>
        <!-- Restore the M2 purple AppBarLayout background. Theme.Material3
             defaults AppBarLayout to colorSurface (white); the app's headers
             are brand purple, so plain AppBarLayouts (e.g. Location history)
             turned white without this. -->
        <item name="appBarLayoutStyle">@style/Widget.App.AppBarLayout</item>

        <!-- ===== Restore M2-appearance component defaults =====
             Theme.Material3 changed dozens of component defaults (shape, size,
             color, elevation) vs M2. The app was pixel-designed for M2, so
             these point each default component style back at an M2-equivalent
             look. Widgets that set an explicit style= or inline attrs override. -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="floatingActionButtonStyle">@style/Widget.App.FloatingActionButton</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.App.ExtendedFloatingActionButton</item>
        <item name="sliderStyle">@style/Widget.App.Slider</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.App.CircularProgressIndicator</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.App.LinearProgressIndicator</item>
        <item name="switchStyle">@style/Widget.App.Switch</item>
        <item name="materialSwitchStyle">@style/Widget.App.MaterialSwitch</item>
        <item name="radioButtonStyle">@style/Widget.App.RadioButton</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="tabStyle">@style/Widget.App.TabLayout</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <!-- Disable the M3 elevation tint that blends elevated surfaces (cards,
             dialogs, menus, sheets) with colorPrimary — it turned every white
             card faint lavender. M2 light theme had no such overlay. -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- ===== Poppins M3 type scale ===== -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.LabelSmall</item>
    </style>

    <style name="SplashRoutingTheme" parent="MaterialAppTheme">
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/colorPrimary</item>
    </style>

    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorPrimary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/SplashRoutingTheme</item>
    </style>

    <style name="ToolbarTheme" parent="MaterialAppTheme">
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:actionMenuTextColor">@android:color/white</item>
    </style>

    <style name="MainToolbarTheme" parent="MaterialAppTheme">
        <item name="android:textColorSecondary">@color/colorPrimary</item>
        <item name="android:textColorPrimary">@color/colorPrimary</item>
        <item name="android:actionMenuTextColor">@color/colorPrimary</item>
    </style>

    <style name="EditTextTheme" parent="Widget.AppCompat.EditText">
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorControlHighlight">@android:color/white</item>
        <item name="colorControlActivated">@android:color/white</item>
    </style>

    <style name="EditTextThemeUser" parent="Widget.AppCompat.EditText">
        <item name="colorControlNormal">@color/colorPrimary</item>
        <item name="colorControlHighlight">@color/colorPrimary</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
    </style>

    <style name="CollapsingToolbarExpanded" parent="ToolbarTheme">
        <item name="android:textColor">@android:color/transparent</item>
    </style>

    <style name="CollapsingToolbarCollapsed" parent="ToolbarTheme">
        <item name="android:textColor">@android:color/transparent</item>
    </style>

    <!-- The screens draw their own header title, so the CollapsingToolbarLayout
         title must stay hidden. Under Theme.Material3 the transparent color on
         the title text appearance is ignored (title renders dark/visible), so
         force it transparent via the direct CTL title-color attrs on the
         app-wide collapsingToolbarLayoutStyle. -->
    <style name="Widget.App.CollapsingToolbar" parent="Widget.Material3.CollapsingToolbar">
        <item name="expandedTitleTextColor">@android:color/transparent</item>
        <item name="collapsedTitleTextColor">@android:color/transparent</item>
    </style>

    <!-- Solid purple app bar (M2 default), no M3 lift-on-scroll surface tint. -->
    <style name="Widget.App.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">@color/colorPrimary</item>
        <item name="liftOnScroll">false</item>
    </style>

    <!-- ================= M2-appearance component defaults ================= -->
    <!-- Buttons: 4dp corners (not the M3 stadium pill) + M2 padding/insets. -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
    </style>

    <!-- Cards: flat white (M2), 4dp corners, no M3 outline/lavender tint. -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
    </style>

    <!-- FAB: circle (not M3 squircle) + brand pink + white icon (M2 default). -->
    <style name="Widget.App.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.Round100</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="tint">@color/white</item>
        <item name="fabCustomSize">0dp</item>
    </style>

    <style name="Widget.App.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="android:minHeight">48dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="backgroundTint">@color/colorAccent</item>
    </style>

    <!-- Slider: round M2 thumb + purple track (not the M3 thin bar / pink). -->
    <style name="Widget.App.Slider" parent="Widget.Material3.Slider.Legacy">
        <item name="trackColorInactive">@color/colorPrimaryTrans</item>
    </style>

    <!-- Progress: M2 ring/bar behavior (no gap, no stop indicator). -->
    <style name="Widget.App.CircularProgressIndicator" parent="Widget.Material3.CircularProgressIndicator.Legacy" />
    <style name="Widget.App.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator.Legacy" />

    <!-- Switches / selection controls: brand pink accent (not M3 baseline). -->
    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="thumbTint">@color/app_switch_thumb_tint</item>
        <item name="trackTint">@color/app_switch_track_tint</item>
        <item name="showText">false</item>
        <item name="android:showText">false</item>
    </style>
    <style name="Widget.App.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/app_switch_thumb_tint</item>
        <item name="trackTint">@color/app_switch_track_tint</item>
        <item name="showText">false</item>
        <item name="android:showText">false</item>
    </style>
    <style name="Widget.App.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/app_selection_control_tint</item>
    </style>
    <style name="Widget.App.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/app_selection_control_tint</item>
    </style>

    <!-- Tabs: full-width straight indicator (M2), 2dp. -->
    <style name="Widget.App.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorHeight">2dp</item>
    </style>

    <!-- Alert dialogs: white container + M2 corner (not lavender / 24dp). -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.App</item>
    </style>
    <style name="MaterialAlertDialog.App" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
    </style>

    <style name="CollapsingTitleCollapsed" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DatePickerDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/background_onboarding</item>
        <item name="buttonBarNegativeButtonStyle">@style/DatePickerDialogTheme.ButtonBarStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/DatePickerDialogTheme.ButtonBarStyle</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DatePickerDialogTheme.ButtonBarStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DatePickerDialogTheme.ButtonBarStyle</item>
    </style>

    <style name="DatePickerDialogTheme.ButtonBarStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/background_onboarding</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="android:backgroundTint">@color/transparent</item>
    </style>

    <style name="AddMomoTheme" parent="MaterialAppTheme">
        <item name="colorError">@android:color/white</item>
        <item name="errorTextColor">@android:color/white</item>
    </style>

    <style name="TextInputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_layout_stroke_color</item>
        <item name="boxStrokeErrorColor">@color/colorAccent</item>
        <item name="errorTextColor">@color/colorAccent</item>
        <item name="errorIconTint">@color/colorAccent</item>
        <item name="android:textColorHint">@color/whiteTrans</item>
        <item name="hintTextColor">@android:color/white</item>
        <item name="suffixTextColor">@android:color/white</item>
        <item name="shapeAppearance">@style/SimCardInputLayoutAppearance</item>
    </style>

    <style name="TextInputLayoutStyleUser" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="boxStrokeErrorColor">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="suffixTextColor">@color/colorPrimary</item>
    </style>

    <style name="ThemeOverlay.App.Button.TextButton" parent="">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ThemeOverlay.App.MyFirstMomoButton" parent="">
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
    </style>

    <style name="ParentControlButtonText">
        <item name="android:textSize">12sp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- backgroundTint is set directly (not via the materialThemeOverlay
         colorPrimary) because the M3 filled button's ?attr/colorPrimary tint
         does not resolve through a per-button materialThemeOverlay in the
         minified release build (renders magenta). Direct backgroundTint is
         deterministic. materialThemeOverlay is kept for icon/ripple tints. -->
    <style name="PinkButtonStyle" parent="Widget.Material3.Button">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.PinkButton</item>
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.RoundedButton</item>
    </style>

    <style name="ThemeOverlay.App.PinkButton" parent="ThemeOverlay.App.MyFirstMomoButton">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="PrimaryButtonStyle" parent="PinkButtonStyle">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.PrimaryButton</item>
        <item name="backgroundTint">@color/colorPrimary</item>
    </style>

    <style name="ParentControlVariableFragmentTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="AppTheme.Picker" parent="Theme.AppCompat.Light.NoActionBar" >
        <item name="android:textColorPrimary">@color/colorPrimary</item>
        <item name="colorControlNormal">@color/colorPrimary</item>
    </style>

    <style name="ThemeOverlay.App.PrimaryButton" parent="ThemeOverlay.App.MyFirstMomoButton">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="CyanButtonStyle" parent="PinkButtonStyle">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.CyanButton</item>
        <item name="backgroundTint">@color/my_first_soymomo_main_button_space2_color</item>
    </style>

    <style name="ThemeOverlay.App.CyanButton" parent="ThemeOverlay.App.MyFirstMomoButton">
        <item name="colorPrimary">@color/my_first_soymomo_main_button_space2_color</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="WhiteOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.MyFirstMomoButton</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.RoundedButton</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/white</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>

    <style name="WhiteOutlinedButtonTransparent" parent="Widget.Material3.Button.OutlinedButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.MyFirstMomoButton</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.RoundedButton</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/transparent</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>

    <style name="PhoneContactTheme" parent="MaterialAppTheme">
        <item name="colorError">@color/phonebook_dialog_error</item>
        <item name="materialAlertDialogTheme">@style/ContactAlertDialogTheme</item>
    </style>

    <style name="ContactAlertDialogTheme" parent="ThemeOverlay.App.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/ContactAlertDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/ContactAlertDialogButtonStyle</item>
    </style>

    <style name="ContactAlertDialogButtonStyle" parent="@style/Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/phonebook_dialog_primary</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputLayout</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="hintTextColor">@color/phonebook_dialog_primary</item>
    </style>

    <style name="ThemeOverlay.App.TextInputLayout" parent="">
        <item name="colorPrimary">@color/phonebook_dialog_primary</item>
        <item name="colorError">@color/phonebook_dialog_error</item>
        <item name="hintTextColor">@color/phonebook_dialog_primary</item>
        <item name="errorTextColor">@color/phonebook_dialog_error</item>
        <item name="boxStrokeColor">@color/color_phone_contact_edit_text</item>
        <item name="boxStrokeErrorColor">@color/color_phone_contact_edit_text_error</item>
    </style>

    <style name="Widget.App.TextInputLayout.Dialog.Invalid.Number" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="materialThemeOverlay">
            @style/ThemeOverlay.App.TextInputLayout.Dialog.Invalid.Number
        </item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="hintTextColor">@color/white</item>
    </style>

    <style name="ThemeOverlay.App.TextInputLayout.Dialog.Invalid.Number" parent="">
        <item name="colorPrimary">@color/white</item>
        <item name="colorError">@color/error_text_dialog</item>
        <item name="hintTextColor">@color/white</item>
        <item name="errorTextColor">@color/error_text_dialog</item>
        <item name="boxStrokeColor">@color/color_phone_contact_edit_text_dialog_invalid_number
        </item>
        <item name="boxStrokeErrorColor">
            @color/color_phone_contact_edit_text_error_dialog_invalid_number
        </item>
    </style>

    <style name="contactImageView">
        <item name="android:padding">2dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@android:color/white</item>
        <item name="strokeWidth">3dp</item>
        <item name="strokeColor">@color/phonebook_image_stroke</item>
        <item name="shapeAppearanceOverlay">@style/circleImageView</item>
    </style>

    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircularImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

