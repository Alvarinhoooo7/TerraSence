<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".sim.ui.fragments.SubscriptionEmptyFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:collapsedTitleTextAppearance="@style/CollapsingToolbarCollapsed"
            app:contentScrim="@color/colorPrimary"
            app:expandedTitleTextAppearance="@style/CollapsingToolbarExpanded"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header"
                style="@style/SimStepCardHeader.Over"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax"
                app:layout_scrollFlags="scroll|enterAlwaysCollapsed">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/app_bar_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_begin="?attr/actionBarSize" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/header_image"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintHeight_percent=".5"
                    style="@style/SimStepCardImage"
                    app:srcCompat="@drawable/ic_soymomo_sim_card"
                    app:layout_constraintTop_toBottomOf="@id/app_bar_guide"
                    app:layout_constraintBottom_toTopOf="@+id/header_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/horizontal_margin_large"
                    android:layout_marginVertical="@dimen/vertical_margin"
                    android:text="@string/add_watch_button_soymomo_sim"
                    style="@style/SimStepCardTitle"
                    app:layout_constraintTop_toBottomOf="@id/header_image"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/background_sim_step_card_title"
                android:theme="@style/ToolbarTheme"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:transitionGroup="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/horizontal_margin"
            android:paddingBottom="@dimen/vertical_margin_large"
            android:background="@color/white">

            <!-- Branded hero: plan illustration over the SIM gradient background,
                 with the tappable "3 types of plans" card overlapping its bottom. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/subscribe_card_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/vertical_margin_large"
                android:paddingHorizontal="@dimen/horizontal_margin"
                android:paddingBottom="@dimen/vertical_margin"
                android:background="@drawable/sim_card_subscribe_background"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintDimensionRatio="h,321:213">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/subscribe_image"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:srcCompat="@drawable/ic_sim_subscribe_plans"
                    app:layout_constraintDimensionRatio="h,28:17"
                    app:layout_constraintTop_toTopOf="parent"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_subscribe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/SimContentCardView"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/horizontal_margin_small">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/subscribe_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/subscription_empty_plan_types"
                            style="@style/SimContentCardTargetViewTitle"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/subscribe_icon" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/subscribe_icon"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@color/sim_button_positive"
                            app:contentPadding="@dimen/horizontal_margin_small"
                            app:srcCompat="@drawable/ic_arrow_go"
                            app:tint="@color/white"
                            app:shapeAppearanceOverlay="@style/circleImageView"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintWidth_percent=".1"
                            app:layout_constraintDimensionRatio="1"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Primary call to action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_subscribe"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/vertical_margin"
                android:text="@string/subscription_empty_soymomo_sim_subscribe"
                app:icon="@drawable/ic_add_24"
                app:iconGravity="textStart"
                style="@style/SimButton.Positive"
                app:layout_constraintTop_toBottomOf="@id/subscribe_card_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- "What is SoyMomo SIM?" explainer -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/explainer_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_large"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/sim_filter_chip_stroke_unchecked"
                app:shapeAppearance="@style/ShapeAppearance.App.SimContentCardView"
                app:layout_constraintTop_toBottomOf="@id/button_subscribe">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/horizontal_margin">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/explainer_image"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:srcCompat="@drawable/subscription_sim_empty"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/footer_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/horizontal_margin"
                        android:text="@string/subscription_empty_what_is_soymomo_sim"
                        android:textColor="@color/background_sim_step_card_title"
                        android:textAlignment="viewStart"
                        style="@style/SimContentCardTargetViewTitle"
                        android:layout_marginHorizontal="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/explainer_image"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/footer_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/horizontal_margin"
                        android:layout_marginTop="@dimen/vertical_margin_smallest"
                        android:fontFamily="@font/poppins"
                        android:text="@string/subscription_empty_soymomo_sim_explanation"
                        android:textAlignment="viewStart"
                        style="@style/SimContentCardViewContent"
                        android:layout_marginHorizontal="0dp"
                        app:layout_constraintTop_toBottomOf="@id/footer_title"
                        app:layout_constraintStart_toEndOf="@id/explainer_image"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
