<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="false">

    <!-- Top Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/toolbar_open"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/none"
            android:layout_marginHorizontal="@dimen/horizontal_margin_small"
            android:layout_marginBottom="@dimen/horizontal_margin_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_settings_menu"
            tools:ignore="RtlSymmetry" />

        <ImageView
            android:id="@+id/toolbar_logo"
            android:layout_width="96dp"
            android:layout_height="0dp"
            android:contentDescription="@string/none"
            app:layout_constraintBottom_toBottomOf="@id/toolbar_open"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/toolbar_open"
            app:srcCompat="@drawable/ic_vector_logo_no_icon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Content Fragment -->
    <fragment
        android:id="@+id/fragment"
        android:name="com.sosmartlabs.momotabletpadres.main.ui.fragment.MainFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_layout"
        app:layout_constraintBottom_toTopOf="@+id/bottom"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout="@layout/main_fragment"
        tools:context="com.sosmartlabs.momo.main.NewMainActivity" />

    <!-- Network Status -->
    <LinearLayout
        android:id="@+id/no_network"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/vertical_margin_smaller"
        android:background="@drawable/button_rounded_pink"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_layout">

        <ProgressBar
            android:id="@+id/no_network_progress_bar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="true"
            android:indeterminateTint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_waiting_for_network"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- Disconnected Prompt -->
    <FrameLayout
        android:id="@+id/disconnected_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="68dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/horizontal_margin"
            android:foregroundGravity="center"
            android:visibility="gone"
            app:cardBackgroundColor="@color/momo_error_background"
            app:cardCornerRadius="24dp"
            app:contentPadding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="4dp"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/main_prompt_device_disconnected_title"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/disconnected_prompt_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/horizontal_margin_small"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:backgroundTint="@color/white"
                    android:elevation="@dimen/card_elevation"
                    android:fontFamily="@font/poppins"
                    android:text="@string/main_prompt_device_disconnected_button"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="@color/momo_error_background"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/first_momo_button_border" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Bottom Section -->
    <FrameLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Empty state moved out of this bottom bar to a full-screen overlay (empty_state_view, below). -->

        <!-- Tablet Selector - Initially hidden, shown when tablets are loaded -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone"
            android:background="@color/white"
            tools:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tablet_selector_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="40dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tablets_recycler_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_tablet_main_selector"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tablets_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tablet_selector_recycler_view"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:itemCount="1"
                tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_tablet_menu_main"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Loading State - Initially visible, hidden when data loads -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="216dp"
            android:layout_gravity="bottom"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/horizontal_margin"
                android:layout_marginTop="64dp"
                android:elevation="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    style="@style/contactImageView"
                    android:layout_width="@dimen/device_card_profile_picture_size"
                    android:layout_height="@dimen/device_card_profile_picture_size"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@drawable/default_profile_pic" />

                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/horizontal_margin_small"
                    android:layout_marginTop="@dimen/vertical_margin_small"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageView10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vertical_margin_small"
                        android:contentDescription="@string/none"
                        android:src="@drawable/loading_textblock_name" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vertical_margin_small"
                        android:contentDescription="@string/none"
                        android:src="@drawable/loading_textblock_phone" />

                </LinearLayout>

            </LinearLayout>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="bottom"
                android:background="@drawable/round_main_card_background"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:background="@drawable/main_card_stars_background"
                    android:contentDescription="@string/none"
                    android:scaleType="fitStart"
                    app:cardElevation="0dp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Load Error State - shown when the device list fails to load -->
        <LinearLayout
            android:id="@+id/load_error"
            android:layout_width="match_parent"
            android:layout_height="216dp"
            android:layout_gravity="bottom"
            android:background="@drawable/round_main_card_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/horizontal_margin"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vertical_margin_small"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:text="@string/main_load_error"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/load_error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_rounded_add_watch"
                android:fontFamily="@font/poppins"
                android:paddingHorizontal="@dimen/horizontal_margin"
                android:text="@string/main_retry"
                android:textColor="@color/white" />

        </LinearLayout>

    </FrameLayout>

    <!-- Empty state: full-screen welcome shown when the parent has no devices yet.
         Drawn last + opaque so it covers the map/shortcuts area; primary CTA is "Add a device". -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/empty_state_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        android:elevation="12dp"
        android:paddingHorizontal="28dp"
        android:paddingBottom="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <!-- Soft halo behind the mascot -->
        <View
            android:id="@+id/empty_state_glow"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:background="@drawable/empty_state_glow_circle"
            app:layout_constraintTop_toTopOf="@id/empty_state_image"
            app:layout_constraintBottom_toBottomOf="@id/empty_state_image"
            app:layout_constraintStart_toStartOf="@id/empty_state_image"
            app:layout_constraintEnd_toEndOf="@id/empty_state_image" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/empty_state_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/momo_greeting"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.6"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/empty_state_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/empty_state_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="@string/main_empty_list_title"
            android:textColor="@color/colorPrimary"
            android:textSize="23sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/empty_state_image"
            app:layout_constraintBottom_toTopOf="@id/empty_state_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/empty_state_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="12dp"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/main_empty_subtitle"
            android:textColor="@color/grey_600"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/empty_state_title"
            app:layout_constraintBottom_toTopOf="@id/empty_state_add_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/empty_state_add_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="34dp"
            android:fontFamily="@font/poppins"
            android:text="@string/main_empty_add_device"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/colorSecondary"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_add_black_24dp"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/empty_state_subtitle"
            app:layout_constraintBottom_toTopOf="@id/empty_state_buy_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/empty_state_buy_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins"
            android:text="@string/main_empty_buy_device"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:layout_constraintTop_toBottomOf="@id/empty_state_add_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
