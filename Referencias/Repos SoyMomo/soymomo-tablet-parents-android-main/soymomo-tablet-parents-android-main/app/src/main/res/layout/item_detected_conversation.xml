<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ly_item_detected_conversation_base"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="15dp"
    android:padding="15dp">

    <ImageView
        android:id="@+id/iv_item_detected_conversation_app_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:srcCompat="@drawable/whatsapp_logo" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dug_profanity_card_icon_margin"
        android:clickable="false"
        app:chipSpacingVertical="4dp"
        app:layout_constraintStart_toEndOf="@+id/iv_item_detected_conversation_app_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tv_item_detected_conversation_title">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_profanity_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipBackgroundColor="@color/dug_switch_color"
            style="@style/Dug.Chip"
            tools:text="Nivel de peligro: Muy grave"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_cyberbullying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dug_cyberbullying_label"
            app:chipBackgroundColor="@color/momoGreyLight"
            style="@style/Dug.Chip"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_grooming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dug_grooming_label"
            app:chipBackgroundColor="@color/momoGreyLight"
            style="@style/Dug.Chip"/>
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tv_item_detected_conversation_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dug_profanity_card_icon_margin"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/chip_group"
        app:layout_constraintBottom_toTopOf="@+id/tv_item_detected_conversation_date"
        app:layout_constraintStart_toEndOf="@+id/iv_item_detected_conversation_app_logo"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="WhatsApp"/>

    <TextView
        android:id="@+id/tv_item_detected_conversation_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dug_profanity_card_icon_margin"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_detected_conversation_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_item_detected_conversation_app_logo"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Conversación detectada 01/01/2021 12:34"/>
</androidx.constraintlayout.widget.ConstraintLayout>