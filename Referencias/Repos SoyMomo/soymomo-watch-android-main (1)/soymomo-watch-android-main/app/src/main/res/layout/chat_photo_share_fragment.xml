<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".chat.presentation.share.ChatPhotoShareFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background_sim_step_card_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ToolbarTheme"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:title="@string/chat_photo_share_title"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/horizontal_margin_medium"
            android:paddingTop="@dimen/vertical_margin_medium"
            android:paddingEnd="@dimen/horizontal_margin_medium"
            android:paddingBottom="@dimen/vertical_margin_medium">

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="@string/chat_photo_share_subtitle"
                android:textColor="@color/momoGrey"
                android:textSize="14sp" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/previewPager"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="@dimen/vertical_margin_medium"
                android:minHeight="200dp" />

            <LinearLayout
                android:id="@+id/previewDots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_small"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/templateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_medium"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="18sp"
                tools:text="Happy Photo"/>

            <TextView
                android:id="@+id/templateDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_smallest"
                android:fontFamily="@font/poppins"
                android:textColor="@color/momoGrey"
                android:textSize="14sp"
                tools:text="A playful and happy version of the photo"/>

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_small"
                android:fontFamily="@font/poppins"
                android:textColor="@color/momo_error_message"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="error"/>

            <ProgressBar
                android:id="@+id/actionsProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/shareTargetsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_medium"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/chat_photo_share_targets_title"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="16sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_small"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/actionsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/instagramStoriesButton"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:contentDescription="@string/chat_photo_share_action_instagram"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="36dp"
                            app:cardElevation="0dp"
                            app:rippleColor="@color/colorPrimaryTrans"
                            app:strokeColor="@color/black_10"
                            app:strokeWidth="1dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_share_instagram_story"
                                    app:tint="@null" />
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/chat_photo_share_action_instagram"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/genericShareButton"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/horizontal_margin_medium"
                        android:clickable="true"
                        android:contentDescription="@string/chat_photo_share_action_share"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="36dp"
                            app:cardElevation="0dp"
                            app:rippleColor="@color/colorPrimaryTrans"
                            app:strokeColor="@color/black_10"
                            app:strokeWidth="1dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_share_generic"
                                    app:tint="@null" />
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/chat_photo_share_action_share"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/saveToDeviceButton"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/horizontal_margin_medium"
                        android:clickable="true"
                        android:contentDescription="@string/chat_photo_share_action_save"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="36dp"
                            app:cardElevation="0dp"
                            app:rippleColor="@color/colorPrimaryTrans"
                            app:strokeColor="@color/black_10"
                            app:strokeWidth="1dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_share_save_to_device"
                                    app:tint="@null" />
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/chat_photo_share_action_save"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
