<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    tools:context=".addfirstwatch.ui.fragments.NeedToolsFragment"
    android:layout_height="match_parent"
    android:background="@color/background_onboarding">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/need_tools_animation"
        android:layout_width="@dimen/onboarding_animation_width_small"
        android:layout_height="@dimen/onboarding_animation_height_small"
        android:layout_marginTop="@dimen/vertical_margin"
        tools:src="@drawable/animation_placeholder_onboarding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/need_tools_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/vertical_margin"
        android:fontFamily="@font/poppins"
        android:text="@string/add_watch_need_tools_title"
        android:textColor="@color/white"
        android:textSize="@dimen/add_watch_title_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/need_tools_animation" />

    <TextView
        android:id="@+id/need_tools_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin_extra_large"
        android:layout_marginVertical="@dimen/vertical_margin_medium"
        android:fontFamily="@font/poppins"
        android:text="@string/add_watch_need_tools_description_1"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="@dimen/add_watch_description_text_size"
        app:layout_constraintBottom_toTopOf="@+id/need_tools_description_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/need_tools_title"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/need_tools_description_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin_extra_large"
        android:layout_marginVertical="@dimen/vertical_margin_medium"
        android:fontFamily="@font/poppins"
        android:text="@string/add_watch_need_tools_description_2"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="@dimen/add_watch_description_text_size_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/need_tools_description" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_next"
        android:layout_width="0dp"
        android:layout_height="@dimen/first_momo_button_height"
        android:backgroundTint="@color/button_onboarding_enabled"
        android:elevation="@dimen/card_elevation"
        android:fontFamily="@font/poppins"
        android:text="@string/button_next"
        android:textSize="@dimen/add_watch_button_text_size"
        android:layout_marginHorizontal="@dimen/horizontal_margin_large"
        android:layout_marginVertical="@dimen/vertical_margin"
        app:cornerRadius="@dimen/first_momo_button_border"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>