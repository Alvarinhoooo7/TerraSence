        <item name="shapeAppearance">@style/ShapeAppearance.App.RoundedButton</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="PlayStoreButton" parent="Widget.MaterialComponents.Button">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.PlayStoreButton</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.RoundedButton</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ShapeAppearance.App.SpotifyButton" parent="ShapeAppearance.App.RoundedButton">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ThemeOverlay.App.SpotifyConfigButton" parent="">
